//@version=6
// =============================================================================
// STOCK SWING — 2R BOOK + STEP-TRAIL STOP VARIANT (daily, CASH EQUITY, long-only)
// -----------------------------------------------------------------------------
// PURPOSE  : HYPOTHESIS TEST, parallel to the validated fixed-2R baseline
//            (src/stock_swing_ribbon_pullback.pine). Keeps the baseline's FIXED 2R
//            full take-profit, but ADDS a ratcheting stop on the way up. Question:
//            does protecting the trade with a step-trail (cost at 1R, lock 1R at 1.5R)
//            improve PF vs the baseline's static -1R stop held to the 2R target?
//            Exact copy of the baseline with ONLY the stop management changed.
// PRIOR    : moving the stop up before target is the RUNNER/BE family, which has lost
//            to fixed-2R every test so far. Tightening the stop converts some eventual
//            2R winners into BE/+1R scratches (whipsaw on the pullback). Prior AGAINST.
//            Adopt ONLY if PF beats fixed-2R across most of the basket; else REJECTED.
// THE CHANGE — single full position, fixed 2R target, stop ratchets UP:
//            maxR < 1.0R (inArmR)        -> SL = initial structural stop
//            reach 1.0R                  -> SL = COST (entry / breakeven)
//            reach 1.5R (arm + stepR)    -> SL = 1.0R (lock 1R)
//            reach 2.0R (inTargetR)      -> FULL BOOK at the limit target
//            Stop hit before 2R -> exit at that (ratcheted) stop. Trend-break closes
//            any open position. maxR = highest favourable excursion in R (bar HIGH).
// SAME      : ribbon regime filter, pullback+2-bar-confirm entry, structural
//            ATR-floored INITIAL stop, R = entry - stop, fixed 2R target, risk-based
//            share sizing, long-only, instrumentation, costs. Stop GEOMETRY unchanged;
//            only upward ratcheting added (math.max).
// NON-REPAINT: maxR uses this bar's completed HIGH; ratcheted stop applies on
//            SUBSEQUENT bars; orders fill at the confirmed bar close (POOC). Up-only stop.
// =============================================================================
strategy(
     title                   = "Stock Swing — 2R Book + Step-Trail (daily, long-only)",
     shorttitle              = "Swing2RT",
     overlay                 = true,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     initial_capital         = 1000000,                       // INR 10 lakh
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.2,                           // ~0.2%/side delivery all-in
     slippage                = 5,
     currency                = currency.INR,
     max_labels_count        = 500,
     max_lines_count         = 500,
     close_entries_rule      = "ANY")

// =============================================================================
// === 1. INPUTS ===
// Mechanism params: pullbackAtr, atrMult, armR, stepR, targetR. Ribbon/ATR/swing
// LENGTHS, riskPct, confirmWin and selectors are STRUCTURAL CONFIG. Ladder SET ONCE.
// =============================================================================
GRP_BIAS    = "Regime (EMA ribbon)"
GRP_ENTRY   = "Entry (pullback)"
GRP_RISK    = "Risk / stop"
GRP_EXIT    = "2R book + step-trail"
GRP_SIZE    = "Position sizing"
GRP_DISPLAY = "Display"

inDirection  = input.string("long_only", "Direction", options = ["long_only", "short_only", "both"], group = GRP_BIAS,
     tooltip = "long_only (DEFAULT). short side rejected (see FINDINGS_STOCKS.md). short_only here = no trades; both = behaves long-only.")
inRibbonMode = input.string("light", "Ribbon mode", options = ["full", "light", "minimal"], group = GRP_BIAS,
     tooltip = "Bullish-trend FILTER. full = 20>50>100>200; light = 20>50>200; minimal = 20>50. ALL also require close > EMA200.")
inEma1 = input.int(20,  "EMA fast (pullback ref)", minval = 2,  group = GRP_BIAS, tooltip = "config")
inEma2 = input.int(50,  "EMA 2",                   minval = 3,  group = GRP_BIAS, tooltip = "config")
inEma3 = input.int(100, "EMA 3",                   minval = 5,  group = GRP_BIAS, tooltip = "config")
inEma4 = input.int(200, "EMA slow (trend anchor)", minval = 10, group = GRP_BIAS, tooltip = "config")

inPullbackEma = input.string("20", "Pull-back to EMA", options = ["20", "50"], group = GRP_ENTRY)
inPullbackAtr = input.float(0.5, "Pull-back tag tolerance (ATR)", minval = 0.0, step = 0.05, group = GRP_ENTRY, tooltip = "[edge param]")
inConfirmWin  = input.int(3, "Confirm window (bars)", minval = 0, group = GRP_ENTRY, tooltip = "config")

inAtrLen      = input.int(14, "ATR length", minval = 1, group = GRP_RISK, tooltip = "config")
inSwingLook   = input.int(10, "Swing-low lookback", minval = 2, group = GRP_RISK, tooltip = "config")
inSwingBufAtr = input.float(0.25, "Swing buffer (ATR)", minval = 0.0, step = 0.05, group = GRP_RISK, tooltip = "config")
inAtrMult     = input.float(1.5, "Min stop distance (ATR)", minval = 0.1, step = 0.1, group = GRP_RISK, tooltip = "Floor on R (initial stop). [edge param]")

inArmR    = input.float(1.0, "Arm at (R) -> SL to cost", minval = 0.25, step = 0.25, group = GRP_EXIT,
     tooltip = "When max favourable excursion reaches this many R, move the stop to COST (breakeven). [mechanism param]")
inStepR   = input.float(0.5, "Trail step (R)", minval = 0.25, step = 0.25, group = GRP_EXIT,
     tooltip = "After arming, each further step ratchets the stop up, trailing this many R behind. e.g. at 1.5R -> SL 1.0R. [mechanism param]")
inTargetR = input.float(2.0, "Full-book target (R)", minval = 0.5, step = 0.1, group = GRP_EXIT,
     tooltip = "Fixed take-profit: book the FULL position here. [mechanism param]")

inRiskPct = input.float(1.0, "Risk % of equity per trade", minval = 0.1, maxval = 10.0, step = 0.1, group = GRP_SIZE,
     tooltip = "shares = floor(equity*risk% / stop-distance), capped at no-leverage. Sizing, not an edge param.")

inShowEmas    = input.bool(true,  "Show ribbon EMAs", group = GRP_DISPLAY)
inShowTp      = input.bool(true,  "Show SL + target + R-milestone lines", group = GRP_DISPLAY)
inShowSignals = input.bool(false, "Show signal markers (debug)", group = GRP_DISPLAY)
inShowDebug   = input.bool(false, "Show debug panels (funnel/exit/MFE/size)", group = GRP_DISPLAY)
inAlertTag    = input.string("STOCK SWING 2RT", "Alert tag", group = GRP_DISPLAY)

// =============================================================================
// === 2. INDICATORS / DATA ===
// =============================================================================
ema1 = ta.ema(close, inEma1)
ema2 = ta.ema(close, inEma2)
ema3 = ta.ema(close, inEma3)
ema4 = ta.ema(close, inEma4)
atrVal   = ta.atr(inAtrLen)
swingLow = ta.lowest(low, inSwingLook)
pullEma  = inPullbackEma == "20" ? ema1 : ema2

// =============================================================================
// === 3. REGIME FILTER (persistent uptrend state — NOT the entry) ===
// =============================================================================
dataReady = not na(ema4) and not na(atrVal)
ribbonBull = switch inRibbonMode
    "full"    => ema1 > ema2 and ema2 > ema3 and ema3 > ema4 and close > ema4
    "minimal" => ema1 > ema2 and close > ema4
    => ema1 > ema2 and ema2 > ema4 and close > ema4          // "light"
longEligible = dataReady and ribbonBull

// =============================================================================
// === 4. SIGNAL LOGIC (identical to baseline) ===
// =============================================================================
tagLong     = low  <= pullEma + inPullbackAtr * atrVal
confirmLong = close > pullEma and close > open
setupLong   = longEligible and tagLong

var int armLong = 0
trigLong  = longEligible and confirmLong and (setupLong or armLong > 0)
armLong  := trigLong ? 0 : setupLong ? inConfirmWin : (armLong > 0 and longEligible) ? armLong - 1 : 0

posOpen = strategy.position_size != 0
sigLong = trigLong and not posOpen

// =============================================================================
// === 5. RISK, SIZING & 2R-BOOK + STEP-TRAIL EXIT STATE ===
// Structural ATR-floored INITIAL stop (UNCHANGED). Fixed 2R target. Stop ratchets up.
// =============================================================================
var int    posDir        = 0
var float  entryPx       = na
var float  initStop      = na
var float  rVal          = na
var float  targetPx      = na          // fixed full-book target (2R)
var float  posShares     = na
var int    entryBarIdx   = na
var string pendingReason = na
var float  stopLevel     = na          // ratcheting (step-trail) stop
var float  hhSince        = na         // highest high since entry
// snapshots for the exit classifier (survive a same-bar re-entry)
var float  closingR      = na
var float  cEntry        = na

// candidate geometry + risk-based size (computed every bar; committed on entry)
candStructStop = swingLow - inSwingBufAtr * atrVal
candFloorStop  = close - inAtrMult * atrVal
candInitStop   = math.min(candStructStop, candFloorStop)     // wider (lower) of the two
candR          = close - candInitStop
candRiskCash   = strategy.equity * inRiskPct / 100.0
candMaxShares  = math.floor(strategy.equity / close)
candShares     = candR > 0 ? math.max(0, math.min(math.floor(candRiskCash / candR), candMaxShares)) : 0
allowLong      = inDirection == "long_only" or inDirection == "both"
doEnterLong    = sigLong and candShares >= 1 and allowLong

// fix geometry on the entry (resume) bar. Non-repaint: completed-bar values.
if doEnterLong
    posDir        := 1
    entryPx       := close
    initStop      := candInitStop
    rVal          := candR
    targetPx      := close + inTargetR * candR               // fixed 2R full-book target
    posShares     := candShares
    entryBarIdx   := bar_index
    pendingReason := na
    stopLevel     := candInitStop
    hhSince       := high

// STEP-TRAIL ladder: ratchet the stop up as max favourable excursion (in R) grows.
// maxR<arm -> initial stop ; arm<=maxR<arm+step -> cost ; beyond -> trail one step behind.
// (The 2R limit books the position before the trail climbs past the 1R lock.)
// Non-repaint: hhSince/high completed; stop applies on subsequent bars; UP-only.
if posOpen and posDir == 1 and rVal > 0
    hhSince := math.max(hhSince, high)
    maxFavR = (hhSince - entryPx) / rVal
    targetSL = initStop
    if maxFavR >= inArmR
        n = math.floor((maxFavR - inArmR) / inStepR)         // n=0 -> just armed (cost); n>=1 -> trailing
        slR = n <= 0 ? 0.0 : inArmR + (n - 1) * inStepR      // locked R level: 0(cost),1.0,1.5,...
        targetSL := entryPx + slR * rVal
    stopLevel := math.max(stopLevel, targetSL)               // ratchet UP only

// snapshot live levels for the classifier
if posOpen
    closingR := rVal
    cEntry   := entryPx

// TREND-BREAK exit: ribbon lost -> close the position.
trendBreak = posOpen and posDir == 1 and not longEligible

// =============================================================================
// === 6. ORDERS ===
// Entry market (fills at this bar's close, POOC). Single full-position bracket: fixed
// 2R limit + the ratcheting stop. strategy.close on trend-break. Same-bar stop+limit
// -> TV fills STOP FIRST (conservative). Non-repaint: orders on confirmed bars.
// =============================================================================
if doEnterLong
    strategy.entry("Long", strategy.long, qty = posShares)

active = posOpen or doEnterLong
if active
    strategy.exit("Bracket", from_entry = "Long", stop = stopLevel, limit = targetPx, comment_profit = "target", comment_loss = "stop")

if trendBreak
    pendingReason := "trendBreak"
    strategy.close("Long", comment = "trend break")

// =============================================================================
// === 7. PLOTTING + INSTRUMENTATION ===
// =============================================================================
plot(inShowEmas ? ema1 : na, "EMA fast", color = color.new(color.yellow, 0),  linewidth = 1)
plot(inShowEmas ? ema2 : na, "EMA 2",    color = color.new(color.orange, 20), linewidth = 1)
plot(inShowEmas ? ema3 : na, "EMA 3",    color = color.new(color.red,    40), linewidth = 1)
plot(inShowEmas ? ema4 : na, "EMA slow", color = color.new(color.fuchsia,0),  linewidth = 2)
bgcolor(longEligible ? color.new(color.green, 92) : na, title = "Uptrend regime")

ctxRejectLong = trigLong and posOpen
plotshape(inShowSignals and trigLong,      title = "raw pullback", style = shape.circle,     location = location.belowbar, color = color.new(color.green, 60), size = size.tiny)
plotshape(inShowSignals and doEnterLong,   title = "ENTER",        style = shape.triangleup, location = location.belowbar, color = color.new(color.lime,  0), size = size.tiny)
plotshape(inShowSignals and ctxRejectLong, title = "in-pos skip",  style = shape.xcross,     location = location.belowbar, color = color.new(color.gray,  0), size = size.tiny)

// --- MFE/MAE shadow-tracker (IGNORES the exit; raw run to -1R stop or trend-break) ---
var array<float> mfeEntry = array.new_float()
var array<float> mfeRpts  = array.new_float()
var array<float> mfeStop  = array.new_float()
var array<float> mfeMaxF  = array.new_float()
var array<float> mfeMaxA  = array.new_float()
var int   mfeN   = 0
var int   mfeGe1 = 0
var int   mfeGe2 = 0
var int   mfeGe3 = 0
var int   mfeGe4 = 0
var int   mfeGe5 = 0
var float mfeSumAdv = 0.0
mfeI = 0
while mfeI < array.size(mfeEntry)
    e   = array.get(mfeEntry, mfeI)
    rp  = array.get(mfeRpts, mfeI)
    stp = array.get(mfeStop, mfeI)
    favR = (high - e) / rp
    advR = (e - low) / rp
    array.set(mfeMaxF, mfeI, math.max(array.get(mfeMaxF, mfeI), favR))
    array.set(mfeMaxA, mfeI, math.max(array.get(mfeMaxA, mfeI), advR))
    if low <= stp or not longEligible
        mx = array.get(mfeMaxF, mfeI)
        mfeN   += 1
        mfeGe1 += mx >= 1.0 ? 1 : 0
        mfeGe2 += mx >= 2.0 ? 1 : 0
        mfeGe3 += mx >= 3.0 ? 1 : 0
        mfeGe4 += mx >= 4.0 ? 1 : 0
        mfeGe5 += mx >= 5.0 ? 1 : 0
        mfeSumAdv += array.get(mfeMaxA, mfeI)
        array.remove(mfeEntry, mfeI)
        array.remove(mfeRpts, mfeI)
        array.remove(mfeStop, mfeI)
        array.remove(mfeMaxF, mfeI)
        array.remove(mfeMaxA, mfeI)
    else
        mfeI += 1
if doEnterLong and candR > 0
    array.push(mfeEntry, close)
    array.push(mfeRpts, candR)
    array.push(mfeStop, candInitStop)
    array.push(mfeMaxF, 0.0)
    array.push(mfeMaxA, 0.0)

// --- entry funnel ---
var int fRibbon = 0
var int fTag    = 0
var int fConf   = 0
var int fSetup  = 0
var int fFull   = 0
fRibbon += nz(longEligible ? 1 : 0)
fTag    += nz(tagLong ? 1 : 0)
fConf   += nz(confirmLong ? 1 : 0)
fSetup  += nz(setupLong ? 1 : 0)
fFull   += nz(trigLong ? 1 : 0)

// --- exit tally (target / stop / BE / trail / trendBreak) + BUY/EXIT labels ---
var int   cntTgt   = 0
var int   cntStop  = 0
var int   cntBE    = 0
var int   cntTrail = 0
var int   cntBreak = 0
var float sumRTgt   = 0.0
var float sumRStop  = 0.0
var float sumRBE    = 0.0
var float sumRTrail = 0.0
var float sumRBreak = 0.0

newOpened = strategy.opentrades > nz(strategy.opentrades[1])
var int prevClosed = 0
if strategy.closedtrades > prevClosed
    for ci = prevClosed to strategy.closedtrades - 1
        xp    = strategy.closedtrades.exit_price(ci)
        ep2   = strategy.closedtrades.entry_price(ci)
        capR  = (na(closingR) or closingR == 0) ? na : (xp - ep2) / closingR
        reason = not na(pendingReason) ? "trendBreak"
             : (not na(capR) and capR >= inTargetR - 0.15) ? "target"
             : (na(capR) or capR <= -0.5) ? "stop"
             : capR < 0.75 ? "BE"
             : "trail"
        if reason == "target"
            cntTgt += 1
            sumRTgt += nz(capR)
        else if reason == "stop"
            cntStop += 1
            sumRStop += nz(capR)
        else if reason == "BE"
            cntBE += 1
            sumRBE += nz(capR)
        else if reason == "trendBreak"
            cntBreak += 1
            sumRBreak += nz(capR)
        else
            cntTrail += 1
            sumRTrail += nz(capR)
        rTxt = na(capR) ? "-" : str.tostring(capR, "#.##") + "R"
        label.new(strategy.closedtrades.exit_bar_index(ci), xp, "EXIT " + rTxt + "\n" + reason,
             xloc = xloc.bar_index, style = label.style_label_down, color = (not na(capR) and capR >= 0 ? color.new(color.orange, 0) : color.new(color.red, 0)),
             textcolor = color.black, size = size.small, tooltip = "EXIT (" + reason + ") " + rTxt + " @ " + str.tostring(xp, format.mintick))
    pendingReason := na
    prevClosed := strategy.closedtrades

if newOpened
    oi   = strategy.opentrades - 1
    obar = strategy.opentrades.entry_bar_index(oi)
    opx  = strategy.opentrades.entry_price(oi)
    // DISPLAY ONLY: surface the strategy's actual trade vars (entryPx/initStop/rVal/targetPx).
    buyTxt = "BUY " + str.tostring(posShares) + " sh"
         + "\nEntry  " + str.tostring(entryPx,  format.mintick)
         + "\nSL  "    + str.tostring(initStop, format.mintick) + "  (-" + str.tostring(entryPx - initStop, format.mintick) + " pts)"
         + "\nTarget " + str.tostring(targetPx, format.mintick) + "  (+" + str.tostring(targetPx - entryPx, format.mintick) + " pts, " + str.tostring(inTargetR) + "R)"
         + "\nR  " + str.tostring(rVal, format.mintick) + " pts"
         + "\nLadder: " + str.tostring(inArmR) + "R->cost, " + str.tostring(inArmR + inStepR) + "R->1R, book@" + str.tostring(inTargetR) + "R"
    label.new(obar, opx, buyTxt, xloc = xloc.bar_index, style = label.style_label_up,
         color = color.new(color.green, 0), textcolor = color.white, size = size.small, tooltip = buyTxt)

// --- live SL (ratchets) + target + R-milestone lines; deleted when flat ---
var line slLn = na
var line tgLn = na
var line m1Ln = na
var line m2Ln = na
if posOpen and inShowTp
    line.delete(slLn)
    line.delete(tgLn)
    line.delete(m1Ln)
    line.delete(m2Ln)
    slLn := line.new(entryBarIdx, stopLevel,            bar_index, stopLevel,            xloc = xloc.bar_index, color = color.new(color.red,   0),  style = line.style_dashed, width = 1)
    tgLn := line.new(entryBarIdx, targetPx,             bar_index, targetPx,             xloc = xloc.bar_index, color = color.new(color.green, 0),  style = line.style_dashed, width = 1)
    m1Ln := line.new(entryBarIdx, entryPx + 1.0 * rVal, bar_index, entryPx + 1.0 * rVal, xloc = xloc.bar_index, color = color.new(color.green, 55), style = line.style_dotted, width = 1)
    m2Ln := line.new(entryBarIdx, entryPx + 1.5 * rVal, bar_index, entryPx + 1.5 * rVal, xloc = xloc.bar_index, color = color.new(color.green, 35), style = line.style_dotted, width = 1)
else
    line.delete(slLn)
    line.delete(tgLn)
    line.delete(m1Ln)
    line.delete(m2Ln)
    slLn := na
    tgLn := na
    m1Ln := na
    m2Ln := na

// --- debug panels ---
var table funT = na
if inShowDebug and barstate.islast
    if na(funT)
        funT := table.new(position.middle_left, 2, 6, border_width = 1)
    table.cell(funT, 0, 0, "FUNNEL", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(funT, 1, 0, "bars",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(funT, 0, 1, "ribbon up",  text_size = size.small)
    table.cell(funT, 1, 1, str.tostring(fRibbon), text_size = size.small)
    table.cell(funT, 0, 2, "tag",        text_size = size.small)
    table.cell(funT, 1, 2, str.tostring(fTag), text_size = size.small)
    table.cell(funT, 0, 3, "confirm",    text_size = size.small)
    table.cell(funT, 1, 3, str.tostring(fConf), text_size = size.small)
    table.cell(funT, 0, 4, "setup",      text_size = size.small)
    table.cell(funT, 1, 4, str.tostring(fSetup), text_size = size.small)
    table.cell(funT, 0, 5, "FULL trig",  bgcolor = color.new(color.orange, 35), text_size = size.small)
    table.cell(funT, 1, 5, str.tostring(fFull), bgcolor = color.new(color.orange, 35), text_size = size.small)

var table exT = na
if inShowDebug and barstate.islast
    if na(exT)
        exT := table.new(position.middle_right, 3, 6, border_width = 1)
    table.cell(exT, 0, 0, "EXIT", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 1, 0, "N",    bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 2, 0, "avgR", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 0, 1, "target (2R)", text_size = size.small)
    table.cell(exT, 1, 1, str.tostring(cntTgt), text_size = size.small)
    table.cell(exT, 2, 1, cntTgt > 0 ? str.tostring(sumRTgt / cntTgt, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 2, "stop (init)", text_size = size.small)
    table.cell(exT, 1, 2, str.tostring(cntStop), text_size = size.small)
    table.cell(exT, 2, 2, cntStop > 0 ? str.tostring(sumRStop / cntStop, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 3, "BE (cost)", text_size = size.small)
    table.cell(exT, 1, 3, str.tostring(cntBE), text_size = size.small)
    table.cell(exT, 2, 3, cntBE > 0 ? str.tostring(sumRBE / cntBE, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 4, "trail (1R lk)", text_size = size.small)
    table.cell(exT, 1, 4, str.tostring(cntTrail), text_size = size.small)
    table.cell(exT, 2, 4, cntTrail > 0 ? str.tostring(sumRTrail / cntTrail, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 5, "trendBreak", text_size = size.small)
    table.cell(exT, 1, 5, str.tostring(cntBreak), text_size = size.small)
    table.cell(exT, 2, 5, cntBreak > 0 ? str.tostring(sumRBreak / cntBreak, "#.##") : "-", text_size = size.small)

var table mfeT = na
if inShowDebug and barstate.islast
    if na(mfeT)
        mfeT := table.new(position.top_left, 3, 7, border_width = 1)
    table.cell(mfeT, 0, 0, "MFE", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 1, 0, "N",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 2, 0, "%",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 0, 1, ">=1R", text_size = size.small)
    table.cell(mfeT, 1, 1, str.tostring(mfeGe1), text_size = size.small)
    table.cell(mfeT, 2, 1, mfeN > 0 ? str.tostring(100.0 * mfeGe1 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 2, ">=2R", text_size = size.small)
    table.cell(mfeT, 1, 2, str.tostring(mfeGe2), text_size = size.small)
    table.cell(mfeT, 2, 2, mfeN > 0 ? str.tostring(100.0 * mfeGe2 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 3, ">=3R", text_size = size.small)
    table.cell(mfeT, 1, 3, str.tostring(mfeGe3), text_size = size.small)
    table.cell(mfeT, 2, 3, mfeN > 0 ? str.tostring(100.0 * mfeGe3 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 4, ">=4R", text_size = size.small)
    table.cell(mfeT, 1, 4, str.tostring(mfeGe4), text_size = size.small)
    table.cell(mfeT, 2, 4, mfeN > 0 ? str.tostring(100.0 * mfeGe4 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 5, ">=5R", text_size = size.small)
    table.cell(mfeT, 1, 5, str.tostring(mfeGe5), text_size = size.small)
    table.cell(mfeT, 2, 5, mfeN > 0 ? str.tostring(100.0 * mfeGe5 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 6, "avgMAE", bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(mfeT, 1, 6, mfeN > 0 ? str.tostring(mfeSumAdv / mfeN, "#.##") + "R" : "-", bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(mfeT, 2, 6, "", bgcolor = color.new(color.teal, 60), text_size = size.small)

var table pT = na
if inShowDebug and barstate.islast
    if na(pT)
        pT := table.new(position.top_right, 2, 7, border_width = 1)
    curMaxR = (posOpen and not na(rVal) and rVal > 0) ? (hhSince - entryPx) / rVal : na
    table.cell(pT, 0, 0, "SWING-2RT", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(pT, 1, 0, longEligible ? "UPTREND" : "no-trade", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(pT, 0, 1, "R / share", text_size = size.small)
    table.cell(pT, 1, 1, candR > 0 ? str.tostring(candR, format.mintick) : "-", text_size = size.small)
    table.cell(pT, 0, 2, "Size now",  text_size = size.small)
    table.cell(pT, 1, 2, str.tostring(candShares) + " sh", text_size = size.small)
    table.cell(pT, 0, 3, "In position", text_size = size.small)
    table.cell(pT, 1, 3, posOpen ? str.tostring(strategy.position_size) + " sh @ " + str.tostring(math.round(entryPx)) : "flat", text_color = posOpen ? color.lime : color.gray, text_size = size.small)
    table.cell(pT, 0, 4, "Max R",     text_size = size.small)
    table.cell(pT, 1, 4, not na(curMaxR) ? str.tostring(curMaxR, "#.##") + "R" : "-", text_size = size.small)
    table.cell(pT, 0, 5, "Stop now",  text_size = size.small)
    table.cell(pT, 1, 5, posOpen ? str.tostring(math.round(stopLevel)) + "  (" + (not na(curMaxR) and curMaxR < inArmR ? "init" : not na(curMaxR) and curMaxR < inArmR + inStepR ? "cost" : "trail") + ")" : "-", text_size = size.small)
    pnl = posOpen ? math.round(close - entryPx) : 0
    table.cell(pT, 0, 6, "Open P&L/sh", text_size = size.small)
    table.cell(pT, 1, 6, posOpen ? str.tostring(pnl) + " pts" : "-", text_color = pnl >= 0 ? color.lime : color.red, text_size = size.small)

// =============================================================================
// === 8. ALERTS ===
// =============================================================================
exitFired = strategy.closedtrades > nz(strategy.closedtrades[1])
alertcondition(doEnterLong, title = "BUY",  message = "BUY {{ticker}} @ {{close}}")
alertcondition(exitFired,   title = "EXIT", message = "EXIT {{ticker}} @ {{close}}")
if doEnterLong
    alert(inAlertTag + " | BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | " + str.tostring(posShares) + " sh", alert.freq_once_per_bar_close)
if exitFired
    alert(inAlertTag + " | EXIT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
