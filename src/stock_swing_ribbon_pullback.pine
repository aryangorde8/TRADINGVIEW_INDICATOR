//@version=6
// =============================================================================
// STOCK SWING — EMA-ribbon-filtered pullback (daily, CASH EQUITY, long-only)
// -----------------------------------------------------------------------------
// PURPOSE  : Swing-trade liquid NSE stocks on the DAILY chart, holding shares
//            overnight (cash/delivery equity — NO options, theta, expiry or
//            force-flat). The pivot from the NIFTY 5m/15m work: stocks trend more
//            cleanly and daily lets trends mature, attacking why intraday failed.
// EDGE     : a SIMPLE, robust pullback WITHIN a confirmed uptrend. Regime = EMA
//            ribbon aligned + price above the long-term EMA (a persistent FILTER).
//            Entry = price pulls back to tag the fast EMA, then a bar resumes up
//            (2-bar confirm window). NO 6-gate confluence stacking — we measure.
// SIZING   : cash equity, risk-based: shares = floor(equity*risk% / stop-distance),
//            capped at no-leverage (equity/price). R is in price; metrics are R-based.
// COSTS    : delivery equity — STT ~0.1% each side + brokerage/charges ~0.1% ≈ 0.2%
//            per side (commission_value below). Adjust per broker (discount ~0.1%,
//            full-service ~0.3%+). Slippage modest for daily fills.
// VALIDATE : single-symbol; APPLY TO MANY liquid names (RELIANCE/HDFCBANK/TCS/INFY/
//            ICICIBANK/...). An edge must hold ACROSS stocks, not one history.
// NON-REPAINT: daily bars, all logic on confirmed-bar close; no request.security;
//            orders fill at the bar close (process_orders_on_close). Justified inline.
// =============================================================================
strategy(
     title                   = "Stock Swing — Ribbon Pullback (daily, long-only)",
     shorttitle              = "SwingRP",
     overlay                 = true,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     initial_capital         = 1000000,                       // INR 10 lakh
     default_qty_type        = strategy.fixed,                // qty is computed per-trade (risk-based) and passed to strategy.entry
     default_qty_value       = 1,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.2,                           // ~0.2%/side delivery all-in (STT ~0.1% + brokerage/charges ~0.1%); tune per broker
     slippage                = 5,
     currency                = currency.INR,
     max_labels_count        = 500,
     max_lines_count         = 500,
     close_entries_rule      = "ANY")

// =============================================================================
// === 1. INPUTS ===
// Edge params (<=8, the ones one might curve-fit): pullbackAtr, atrMult, rrTarget,
// firstTgtR, trailAtrMult (5). Ribbon/ATR/swing LENGTHS, riskPct, confirmWin and the
// categorical mode selectors are STRUCTURAL CONFIG — not to be optimised.
// =============================================================================
GRP_BIAS    = "Regime (EMA ribbon)"
GRP_ENTRY   = "Entry (pullback)"
GRP_RISK    = "Risk / target"
GRP_RUNNER  = "Runner exit"
GRP_SIZE    = "Position sizing"
GRP_DISPLAY = "Display"

inDirection  = input.string("long_only", "Direction (DEPLOYABLE = long_only)", options = ["long_only", "short_only", "both"], group = GRP_BIAS,
     tooltip = "long_only (DEFAULT, DEPLOYABLE) = the validated edge (11/15 names profitable, PFs to 1.89). short_only / both are TESTED-AND-REJECTED: the symmetric short was built on futures (stock_swing_short_futures.pine) and only 2/5 downtrenders were weakly profitable (squeeze-bounce stop-outs) — too weak/inconsistent to trade. This deployable file trades LONG ONLY; the bear-market answer is CASH (capital preservation), not shorting. short_only here = no trades; both = behaves long-only.")
inRibbonMode = input.string("light", "Ribbon mode", options = ["full", "light", "minimal"], group = GRP_BIAS,
     tooltip = "Bullish-trend FILTER (persistent, NOT the entry). full = 20>50>100>200; light = 20>50>200; minimal = 20>50. ALL modes also require close > the long-term EMA (200). Price is NOT required above the FAST EMA — that is where the pullback happens.")
inEma1 = input.int(20,  "EMA fast (pullback ref)", minval = 2,  group = GRP_BIAS, tooltip = "config")
inEma2 = input.int(50,  "EMA 2",                   minval = 3,  group = GRP_BIAS, tooltip = "config")
inEma3 = input.int(100, "EMA 3",                   minval = 5,  group = GRP_BIAS, tooltip = "config")
inEma4 = input.int(200, "EMA slow (trend anchor)", minval = 10, group = GRP_BIAS, tooltip = "config")

inPullbackEma = input.string("20", "Pull-back to EMA", options = ["20", "50"], group = GRP_ENTRY,
     tooltip = "Which EMA the bar's low must tag. 20 = shallow pullbacks (more trades); 50 = deeper (fewer).")
inPullbackAtr = input.float(0.5, "Pull-back tag tolerance (ATR)", minval = 0.0, step = 0.05, group = GRP_ENTRY,
     tooltip = "How close (ATR units) the bar's low must come to the pull-back EMA to count as a tag. [edge param]")
inConfirmWin  = input.int(3, "Confirm window (bars)", minval = 0, group = GRP_ENTRY,
     tooltip = "After a tag arms, the bullish-resume bar may appear on the tag bar OR within this many following bars while the ribbon holds. Daily default 3. config")

inAtrLen      = input.int(14, "ATR length", minval = 1, group = GRP_RISK, tooltip = "config")
inSwingLook   = input.int(10, "Swing-low lookback", minval = 2, group = GRP_RISK, tooltip = "Bars for the pullback swing low (structural stop). config")
inSwingBufAtr = input.float(0.25, "Swing buffer (ATR)", minval = 0.0, step = 0.05, group = GRP_RISK, tooltip = "Stop placed this far below the swing low so wicks don't clip it. config")
inAtrMult     = input.float(1.5, "Min stop distance (ATR)", minval = 0.1, step = 0.1, group = GRP_RISK,
     tooltip = "Floor on R: stop never tighter than this*ATR (structural swing stop used when WIDER). [edge param]")
inRrTarget    = input.float(2.0, "Reward:Risk target", minval = 0.5, step = 0.1, group = GRP_RISK,
     tooltip = "Fixed target = entry + rrTarget*R (used when runner OFF). [edge param]")

inUseRunner    = input.bool(false, "Use runner (partial + trail)", group = GRP_RUNNER,
     tooltip = "OFF (default) = fixed rrTarget. ON = book bookFrac at firstTgtR, let the rest run on a loose chandelier. STOCKS may have a fat enough trend-tail to harvest (the MFE panel shows whether).")
inBookFrac     = input.float(50.0, "Book % at first target", minval = 1.0, maxval = 99.0, step = 5.0, group = GRP_RUNNER)
inFirstTgtR    = input.float(2.0, "First target (R)", minval = 0.5, step = 0.5, group = GRP_RUNNER, tooltip = "Runner books here. [edge param when runner on]")
inTrailAtrMult = input.float(3.0, "Runner trail ATR mult", minval = 0.5, step = 0.5, group = GRP_RUNNER,
     tooltip = "Chandelier distance (highest-high-since-entry - mult*ATR). Keep LOOSE for fat trend tails. [edge param when runner on]")

inRiskPct = input.float(1.0, "Risk % of equity per trade", minval = 0.1, maxval = 10.0, step = 0.1, group = GRP_SIZE,
     tooltip = "shares = floor(equity*risk% / stop-distance-per-share), capped at no-leverage (equity/price). Sizing, not an edge param.")

inShowEmas    = input.bool(true,  "Show ribbon EMAs", group = GRP_DISPLAY)
inShowTp      = input.bool(true,  "Show stop/target lines", group = GRP_DISPLAY)
inShowSignals = input.bool(false, "Show signal markers (debug)", group = GRP_DISPLAY)
inShowDebug   = input.bool(false, "Show debug panels (funnel/exit/MFE/size)", group = GRP_DISPLAY)
inShowBadge   = input.bool(true,  "Show regime status badge (weekly-scan tool)", group = GRP_DISPLAY,
     tooltip = "PURE DISPLAY (no effect on trades). Reads the SAME ribbon rule the strategy trades and shows BULLISH / BEARISH / NEUTRAL for the current bar. BULLISH = a name to WATCH for a pullback entry — NOT buy-now (the entry is still the pullback+confirm the strategy generates). Use it to scan a watchlist for tradeable-long regime.")
inAlertTag    = input.string("STOCK SWING", "Alert tag", group = GRP_DISPLAY)

// =============================================================================
// === 2. INDICATORS / DATA ===
// All on completed-bar values; each computed once, unconditionally.
// =============================================================================
ema1 = ta.ema(close, inEma1)
ema2 = ta.ema(close, inEma2)
ema3 = ta.ema(close, inEma3)
ema4 = ta.ema(close, inEma4)
atrVal   = ta.atr(inAtrLen)
swingLow = ta.lowest(low, inSwingLook)
pullEma  = inPullbackEma == "20" ? ema1 : ema2

// =============================================================================
// === 3. REGIME FILTER (persistent uptrend state — NOT the entry) ===
// Ribbon stacked bullish + price above the long-term anchor (200). Price is NOT
// required above the fast EMA (the pullback tags it). dataReady gates warm-up.
// Non-repaint: EMAs/close are completed-bar values.
// =============================================================================
dataReady = not na(ema4) and not na(atrVal)
ribbonBull = switch inRibbonMode
    "full"    => ema1 > ema2 and ema2 > ema3 and ema3 > ema4 and close > ema4
    "minimal" => ema1 > ema2 and close > ema4
    => ema1 > ema2 and ema2 > ema4 and close > ema4          // "light"
longEligible = dataReady and ribbonBull

// =============================================================================
// === 4. SIGNAL LOGIC ===
// Entry = pullback tag (bar low reaches the pull EMA) + a bullish resume bar (close
// back above the pull EMA), within a 2..N-bar confirm window, while the regime holds.
// Non-repaint: low/open/close are the COMPLETED bar's OHLC; pullEma/atrVal completed;
// decided at bar close (orders fill at that close) -> cannot move on a later tick.
// =============================================================================
tagLong     = low  <= pullEma + inPullbackAtr * atrVal       // bar dipped to/near the pull EMA
confirmLong = close > pullEma and close > open               // bullish resume back above the pull EMA
setupLong   = longEligible and tagLong                       // pullback armed within the uptrend

var int armLong = 0
trigLong  = longEligible and confirmLong and (setupLong or armLong > 0)
armLong  := trigLong ? 0 : setupLong ? inConfirmWin : (armLong > 0 and longEligible) ? armLong - 1 : 0

posOpen = strategy.position_size != 0
sigLong = trigLong and not posOpen                           // only when flat (pyramiding=0)

// =============================================================================
// === 5. RISK, SIZING & EXITS ===
// Structural stop below the pullback swing low (ATR-floored). Risk-based share count.
// Optional partial + chandelier runner. Trend-break (ribbon lost) is a hard exit.
// =============================================================================
var int    posDir          = 0
var float  entryPx         = na
var float  initStop        = na
var float  rVal            = na
var float  targetPx        = na
var float  firstTgtPx      = na
var float  runnerStop      = na
var bool   t1Done          = false
var float  hhSince         = na
var float  posShares       = na
var int    entryBarIdx     = na
var string pendingReason   = na
var float  closingTgt      = na
var float  closingR        = na

// candidate geometry + risk-based size (computed every bar; committed on entry)
candStructStop = swingLow - inSwingBufAtr * atrVal
candFloorStop  = close - inAtrMult * atrVal
candInitStop   = math.min(candStructStop, candFloorStop)     // wider (lower) of the two
candR          = close - candInitStop
candRiskCash   = strategy.equity * inRiskPct / 100.0
candMaxShares  = math.floor(strategy.equity / close)         // no leverage (cash equity)
candShares     = candR > 0 ? math.max(0, math.min(math.floor(candRiskCash / candR), candMaxShares)) : 0
allowLong      = inDirection == "long_only" or inDirection == "both"   // short rejected -> only long is deployable
doEnterLong    = sigLong and candShares >= 1 and allowLong   // need >=1 affordable, risk-sized share; direction-gated

// fix geometry on the entry (resume) bar. Non-repaint: completed-bar values; close=fill.
if doEnterLong
    posDir        := 1
    entryPx       := close
    initStop      := candInitStop
    rVal          := candR
    targetPx      := close + inRrTarget * candR
    firstTgtPx    := close + inFirstTgtR * candR
    posShares     := candShares
    runnerStop    := candInitStop
    t1Done        := false
    hhSince       := high
    entryBarIdx   := bar_index
    pendingReason := na

// runner stop (ONLY when inUseRunner): book at firstTgt, then BE + loose chandelier.
// Non-repaint: hhSince/high/atrVal completed; new stop checked on SUBSEQUENT bars.
if inUseRunner and posOpen and posDir == 1 and rVal > 0
    hhSince := math.max(hhSince, high)
    if not t1Done and high >= firstTgtPx
        t1Done := true
    runnerStop := t1Done ? math.max(runnerStop, math.max(entryPx, hhSince - inTrailAtrMult * atrVal)) : initStop

// snapshot live levels so the exit-reason classifier survives a same-bar re-entry
if posOpen
    closingTgt := inUseRunner ? firstTgtPx : targetPx
    closingR   := rVal

// TREND-BREAK exit: the ribbon regime is lost -> close the swing (no time-stop; swing holds across days).
// Non-repaint: longEligible from completed EMAs; close fills at this bar's close.
trendBreak = posOpen and posDir == 1 and not longEligible

// share split for the runner
bookShares = math.max(1.0, math.min(posShares - 1.0, math.round(posShares * inBookFrac / 100.0)))
runShares  = posShares - bookShares

// =============================================================================
// === 6. ORDERS ===
// Entry: long = buy shares (risk-sized). Exit: fixed bracket OR partial+runner;
// strategy.close on trend-break. Non-repaint: orders on confirmed bars; market entry
// fills at THIS bar's close (process_orders_on_close). Same-bar stop+target -> TV
// fills STOP FIRST (conservative); no bar-magnifier hacks.
// =============================================================================
if doEnterLong
    strategy.entry("Long", strategy.long, qty = posShares)

active = posOpen or doEnterLong
if inUseRunner
    if active and not t1Done and bookShares >= 1
        strategy.exit("T1",  from_entry = "Long", qty = bookShares, stop = initStop,   limit = firstTgtPx, comment_profit = "target", comment_loss = "stop")
    if active and runShares >= 1
        strategy.exit("Run", from_entry = "Long", qty = runShares, stop = runnerStop,  comment_profit = "runnerTrail", comment_loss = "stop")
else
    if active
        strategy.exit("Bracket", from_entry = "Long", stop = initStop, limit = targetPx, comment_profit = "target", comment_loss = "stop")

if trendBreak
    pendingReason := "trendBreak"
    strategy.close("Long", comment = "trend break")

// =============================================================================
// === 7. PLOTTING + INSTRUMENTATION ===
// =============================================================================
// ribbon EMAs (context)
plot(inShowEmas ? ema1 : na, "EMA fast", color = color.new(color.yellow, 0),  linewidth = 1)
plot(inShowEmas ? ema2 : na, "EMA 2",    color = color.new(color.orange, 20), linewidth = 1)
plot(inShowEmas ? ema3 : na, "EMA 3",    color = color.new(color.red,    40), linewidth = 1)
plot(inShowEmas ? ema4 : na, "EMA slow", color = color.new(color.fuchsia,0),  linewidth = 2)
bgcolor(longEligible ? color.new(color.green, 92) : na, title = "Uptrend regime")

// --- REGIME STATUS BADGE (PURE DISPLAY — no effect on entries/exits) ---
// Reads the SAME ribbon rule the strategy trades (BULLISH = ribbonBull, the long
// filter), respecting inRibbonMode, so it matches what the strategy would trade.
// BULLISH = a candidate to WATCH for a pullback entry, NOT a buy-now trigger.
ribbonBear = switch inRibbonMode
    "full"    => ema1 < ema2 and ema2 < ema3 and ema3 < ema4 and close < ema4
    "minimal" => ema1 < ema2 and close < ema4
    => ema1 < ema2 and ema2 < ema4 and close < ema4          // "light" (mirror of ribbonBull)
regimeState = not dataReady ? "WARMUP" : ribbonBull ? "BULLISH" : ribbonBear ? "BEARISH" : "NEUTRAL"
badgeTxt = regimeState == "BULLISH" ? "BULLISH — uptrend, watch for pullback entry"
     : regimeState == "BEARISH"     ? "BEARISH — downtrend, stay in cash"
     : regimeState == "NEUTRAL"     ? "NEUTRAL — no clean trend, skip"
     :                                "warming up…"
badgeCol = regimeState == "BULLISH" ? color.new(color.green,  0)
     : regimeState == "BEARISH"     ? color.new(color.red,    0)
     : regimeState == "NEUTRAL"     ? color.new(color.orange, 10)
     :                                color.new(color.gray,   0)
distPct = (not na(ema4) and ema4 != 0) ? (close - ema4) / ema4 * 100.0 : na
distStr = not na(distPct) ? (distPct >= 0 ? "+" : "") + str.tostring(distPct, "#.#") + "%" : "—"
var table badgeT = na
if inShowBadge and barstate.islast
    if na(badgeT)
        badgeT := table.new(position.top_center, 1, 2, border_width = 1)
    table.cell(badgeT, 0, 0, badgeTxt, bgcolor = badgeCol, text_color = color.white, text_size = size.normal)
    table.cell(badgeT, 0, 1, "price vs EMA" + str.tostring(inEma4) + ": " + distStr + "  ·  mode: " + inRibbonMode + "  ·  regime filter, WATCH not buy",
         bgcolor = color.new(color.black, 15), text_color = color.silver, text_size = size.small)

// --- debug signal markers (viz only; no order effect) ---
ctxRejectLong = trigLong and posOpen   // trigger fired but already in a position
plotshape(inShowSignals and trigLong,       title = "raw pullback", style = shape.circle,     location = location.belowbar, color = color.new(color.green, 60), size = size.tiny)
plotshape(inShowSignals and doEnterLong,    title = "ENTER",        style = shape.triangleup, location = location.belowbar, color = color.new(color.lime,  0), size = size.tiny)
plotshape(inShowSignals and ctxRejectLong,  title = "in-pos skip",  style = shape.xcross,     location = location.belowbar, color = color.new(color.gray,  0), size = size.tiny)

// --- MFE/MAE shadow-tracker: how far entries run in R, IGNORING the target, until
//     the -1R stop OR a trend-break (ribbon loss). Concurrent shadows in arrays. ---
var array<float> mfeEntry = array.new_float()
var array<float> mfeRpts  = array.new_float()
var array<float> mfeStop  = array.new_float()
var array<float> mfeMaxF  = array.new_float()
var array<float> mfeMaxA  = array.new_float()
var int   mfeN   = 0
var int   mfeGe1 = 0
var int   mfeGe2 = 0
var int   mfeGe3 = 0
var int   mfeGe4 = 0
var int   mfeGe5 = 0
var float mfeSumAdv = 0.0
mfeI = 0
while mfeI < array.size(mfeEntry)
    e   = array.get(mfeEntry, mfeI)
    rp  = array.get(mfeRpts, mfeI)
    stp = array.get(mfeStop, mfeI)
    favR = (high - e) / rp
    advR = (e - low) / rp
    array.set(mfeMaxF, mfeI, math.max(array.get(mfeMaxF, mfeI), favR))
    array.set(mfeMaxA, mfeI, math.max(array.get(mfeMaxA, mfeI), advR))
    if low <= stp or not longEligible
        mx = array.get(mfeMaxF, mfeI)
        mfeN   += 1
        mfeGe1 += mx >= 1.0 ? 1 : 0
        mfeGe2 += mx >= 2.0 ? 1 : 0
        mfeGe3 += mx >= 3.0 ? 1 : 0
        mfeGe4 += mx >= 4.0 ? 1 : 0
        mfeGe5 += mx >= 5.0 ? 1 : 0
        mfeSumAdv += array.get(mfeMaxA, mfeI)
        array.remove(mfeEntry, mfeI)
        array.remove(mfeRpts, mfeI)
        array.remove(mfeStop, mfeI)
        array.remove(mfeMaxF, mfeI)
        array.remove(mfeMaxA, mfeI)
    else
        mfeI += 1
if doEnterLong and candR > 0
    array.push(mfeEntry, close)
    array.push(mfeRpts, candR)
    array.push(mfeStop, candInitStop)
    array.push(mfeMaxF, 0.0)
    array.push(mfeMaxA, 0.0)

// --- entry funnel (cumulative bar-counts; na-guarded) ---
var int fRibbon = 0
var int fTag    = 0
var int fConf   = 0
var int fSetup  = 0
var int fFull   = 0
fRibbon += nz(longEligible ? 1 : 0)
fTag    += nz(tagLong ? 1 : 0)
fConf   += nz(confirmLong ? 1 : 0)
fSetup  += nz(setupLong ? 1 : 0)
fFull   += nz(trigLong ? 1 : 0)

// --- exit-reason tally + BUY/EXIT labels off ACTUAL fills (per leg) ---
var int   cntTarget = 0
var int   cntRunner = 0
var int   cntStop   = 0
var int   cntBreak  = 0
var float sumRTarget = 0.0
var float sumRRunner = 0.0
var float sumRStop   = 0.0
var float sumRBreak  = 0.0

newOpened = strategy.opentrades > nz(strategy.opentrades[1])
var int prevClosed = 0
if strategy.closedtrades > prevClosed
    for ci = prevClosed to strategy.closedtrades - 1
        xb = strategy.closedtrades.exit_bar_index(ci)
        xp = strategy.closedtrades.exit_price(ci)
        ep2 = strategy.closedtrades.entry_price(ci)
        prof = strategy.closedtrades.profit(ci)
        isTgt = not na(closingTgt) and xp >= closingTgt - syminfo.mintick * 2
        reason = isTgt ? "target" : (not na(pendingReason) ? pendingReason : (prof > 0 ? "runnerTrail" : "stop"))
        rM = (na(closingR) or closingR == 0) ? na : (xp - ep2) / closingR
        if reason == "target"
            cntTarget += 1
            sumRTarget += nz(rM)
        else if reason == "runnerTrail"
            cntRunner += 1
            sumRRunner += nz(rM)
        else if reason == "trendBreak"
            cntBreak += 1
            sumRBreak += nz(rM)
        else
            cntStop += 1
            sumRStop += nz(rM)
        label.new(xb, xp, "EXIT", xloc = xloc.bar_index, style = label.style_label_down,
             color = color.new(color.orange, 0), textcolor = color.black, size = size.small,
             tooltip = "EXIT (" + reason + ") @ " + str.tostring(xp, format.mintick))
    pendingReason := na
    prevClosed := strategy.closedtrades

if newOpened
    oi  = strategy.opentrades - 1
    obar = strategy.opentrades.entry_bar_index(oi)
    opx  = strategy.opentrades.entry_price(oi)
    // DISPLAY ONLY: surface the trade levels the strategy already computed for THIS
    // trade (entryPx / initStop / targetPx / rVal) into the label text. Nothing is
    // recomputed — these are the same vars that drive strategy.exit and the SL/Tgt lines.
    buyTxt = "BUY " + str.tostring(posShares) + " sh"
         + "\nEntry  " + str.tostring(entryPx,  format.mintick)
         + "\nSL  "    + str.tostring(initStop, format.mintick) + "  (-" + str.tostring(entryPx - initStop, format.mintick) + " pts)"
         + "\nTarget " + str.tostring(targetPx, format.mintick) + "  (+" + str.tostring(targetPx - entryPx, format.mintick) + " pts)"
         + "\nR  " + str.tostring(rVal, format.mintick) + " pts  (1:" + str.tostring(inRrTarget) + ")"
    label.new(obar, opx, buyTxt, xloc = xloc.bar_index, style = label.style_label_up,
         color = color.new(color.green, 0), textcolor = color.white, size = size.small,
         tooltip = buyTxt)

// --- live stop/target lines (deleted when flat) ---
liveTgt = inUseRunner ? firstTgtPx : targetPx
liveStp = inUseRunner ? runnerStop : initStop
var line stopLn = na
var line tgtLn  = na
if posOpen and inShowTp
    line.delete(stopLn)
    line.delete(tgtLn)
    stopLn := line.new(entryBarIdx, liveStp, bar_index, liveStp, xloc = xloc.bar_index, color = color.new(color.red,   0), style = line.style_dashed, width = 1)
    tgtLn  := line.new(entryBarIdx, liveTgt, bar_index, liveTgt, xloc = xloc.bar_index, color = color.new(color.green, 0), style = line.style_dashed, width = 1)
else
    line.delete(stopLn)
    line.delete(tgtLn)
    stopLn := na
    tgtLn  := na

// --- debug panels ---
var table funT = na
if inShowDebug and barstate.islast
    if na(funT)
        funT := table.new(position.middle_left, 2, 6, border_width = 1)
    table.cell(funT, 0, 0, "FUNNEL", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(funT, 1, 0, "bars",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(funT, 0, 1, "ribbon up",  text_size = size.small)
    table.cell(funT, 1, 1, str.tostring(fRibbon), text_size = size.small)
    table.cell(funT, 0, 2, "tag",        text_size = size.small)
    table.cell(funT, 1, 2, str.tostring(fTag), text_size = size.small)
    table.cell(funT, 0, 3, "confirm",    text_size = size.small)
    table.cell(funT, 1, 3, str.tostring(fConf), text_size = size.small)
    table.cell(funT, 0, 4, "setup",      text_size = size.small)
    table.cell(funT, 1, 4, str.tostring(fSetup), text_size = size.small)
    table.cell(funT, 0, 5, "FULL entry", bgcolor = color.new(color.orange, 35), text_size = size.small)
    table.cell(funT, 1, 5, str.tostring(fFull), bgcolor = color.new(color.orange, 35), text_size = size.small)

var table exT = na
if inShowDebug and barstate.islast
    if na(exT)
        exT := table.new(position.middle_right, 3, 5, border_width = 1)   // off the bottom so the tester pane doesn't hide it
    table.cell(exT, 0, 0, "EXIT", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 1, 0, "N",    bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 2, 0, "avgR", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(exT, 0, 1, "target",     text_size = size.small)
    table.cell(exT, 1, 1, str.tostring(cntTarget), text_size = size.small)
    table.cell(exT, 2, 1, cntTarget > 0 ? str.tostring(sumRTarget / cntTarget, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 2, "runnerTrail",text_size = size.small)
    table.cell(exT, 1, 2, str.tostring(cntRunner), text_size = size.small)
    table.cell(exT, 2, 2, cntRunner > 0 ? str.tostring(sumRRunner / cntRunner, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 3, "stop",       text_size = size.small)
    table.cell(exT, 1, 3, str.tostring(cntStop), text_size = size.small)
    table.cell(exT, 2, 3, cntStop > 0 ? str.tostring(sumRStop / cntStop, "#.##") : "-", text_size = size.small)
    table.cell(exT, 0, 4, "trendBreak", text_size = size.small)
    table.cell(exT, 1, 4, str.tostring(cntBreak), text_size = size.small)
    table.cell(exT, 2, 4, cntBreak > 0 ? str.tostring(sumRBreak / cntBreak, "#.##") : "-", text_size = size.small)

var table mfeT = na
if inShowDebug and barstate.islast
    if na(mfeT)
        mfeT := table.new(position.top_left, 3, 7, border_width = 1)   // top_left: clear of the Strategy-Tester pane (which hides bottom tables)
    table.cell(mfeT, 0, 0, "MFE", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 1, 0, "N",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 2, 0, "%",   bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(mfeT, 0, 1, ">=1R", text_size = size.small)
    table.cell(mfeT, 1, 1, str.tostring(mfeGe1), text_size = size.small)
    table.cell(mfeT, 2, 1, mfeN > 0 ? str.tostring(100.0 * mfeGe1 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 2, ">=2R", text_size = size.small)
    table.cell(mfeT, 1, 2, str.tostring(mfeGe2), text_size = size.small)
    table.cell(mfeT, 2, 2, mfeN > 0 ? str.tostring(100.0 * mfeGe2 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 3, ">=3R", text_size = size.small)
    table.cell(mfeT, 1, 3, str.tostring(mfeGe3), text_size = size.small)
    table.cell(mfeT, 2, 3, mfeN > 0 ? str.tostring(100.0 * mfeGe3 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 4, ">=4R", text_size = size.small)
    table.cell(mfeT, 1, 4, str.tostring(mfeGe4), text_size = size.small)
    table.cell(mfeT, 2, 4, mfeN > 0 ? str.tostring(100.0 * mfeGe4 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 5, ">=5R", text_size = size.small)
    table.cell(mfeT, 1, 5, str.tostring(mfeGe5), text_size = size.small)
    table.cell(mfeT, 2, 5, mfeN > 0 ? str.tostring(100.0 * mfeGe5 / mfeN, "#.#") : "-", text_size = size.small)
    table.cell(mfeT, 0, 6, "avgMAE", bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(mfeT, 1, 6, mfeN > 0 ? str.tostring(mfeSumAdv / mfeN, "#.##") + "R" : "-", bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(mfeT, 2, 6, "", bgcolor = color.new(color.teal, 60), text_size = size.small)

// --- position-size / state panel ---
var table pT = na
if inShowDebug and barstate.islast
    if na(pT)
        pT := table.new(position.top_right, 2, 7, border_width = 1)
    table.cell(pT, 0, 0, "SWING", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(pT, 1, 0, longEligible ? "UPTREND" : "no-trade", bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(pT, 0, 1, "Risk %",    text_size = size.small)
    table.cell(pT, 1, 1, str.tostring(inRiskPct) + "%  (" + str.tostring(math.round(candRiskCash)) + ")", text_size = size.small)
    table.cell(pT, 0, 2, "R / share", text_size = size.small)
    table.cell(pT, 1, 2, candR > 0 ? str.tostring(candR, format.mintick) : "-", text_size = size.small)
    table.cell(pT, 0, 3, "Size now",  text_size = size.small)
    table.cell(pT, 1, 3, str.tostring(candShares) + " sh", text_size = size.small)
    table.cell(pT, 0, 4, "In position", text_size = size.small)
    table.cell(pT, 1, 4, posOpen ? str.tostring(posShares) + " sh @ " + str.tostring(math.round(entryPx)) : "flat", text_color = posOpen ? color.lime : color.gray, text_size = size.small)
    table.cell(pT, 0, 5, "Stop / Tgt", text_size = size.small)
    table.cell(pT, 1, 5, posOpen ? str.tostring(math.round(liveStp)) + " / " + str.tostring(math.round(liveTgt)) : "-", text_size = size.small)
    pnl = posOpen ? math.round(close - entryPx) : 0
    table.cell(pT, 0, 6, "Open P&L/sh", text_size = size.small)
    table.cell(pT, 1, 6, posOpen ? str.tostring(pnl) + " pts" : "-", text_color = pnl >= 0 ? color.lime : color.red, text_size = size.small)

// =============================================================================
// === 8. ALERTS ===
// =============================================================================
exitFired = strategy.closedtrades > nz(strategy.closedtrades[1])
alertcondition(doEnterLong, title = "BUY",  message = "BUY {{ticker}} @ {{close}}")
alertcondition(exitFired,   title = "EXIT", message = "EXIT {{ticker}} @ {{close}}")
if doEnterLong
    alert(inAlertTag + " | BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | " + str.tostring(posShares) + " sh", alert.freq_once_per_bar_close)
if exitFired
    alert(inAlertTag + " | EXIT " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
