//@version=6
// =============================================================================
// NIFTY FUT 5m — Intraday Options-Directional Strategy (Variant A: breakout)
// -----------------------------------------------------------------------------
// PURPOSE  : Directional intraday signals for buying NIFTY index OPTIONS (CE=long,
//            PE=short). The script runs on the NIFTY *futures* underlying, NOT on
//            option premium. Strategy-Tester results are a directional UPPER BOUND
//            on real CE/PE P&L — they do NOT model premium, theta or IV.
// INSTRUMENT: Designed for NIFTY futures (e.g. NSE:NIFTY1! continuous front-month,
//            or the active monthly contract for clean single-period tests). Futures
//            carry real volume, so ta.vwap is valid as the PRIMARY bias reference;
//            it degrades gracefully to SessionAvg on volume-less feeds.
// ROLLOVER : On a continuous contract (NIFTY1!) the monthly rollover can produce
//            one anomalous bar/gap. This is FLAGGED, not handled — do not add
//            rollover logic; just be aware one print per month may be distorted.
// SCAFFOLD : Phase 1 = inputs + data layer + session detection + display only.
//            Sections 4/5/6/8 (gates, risk, orders, alerts) are headered stubs
//            filled in later phases. Strategy issues NO orders yet.
// =============================================================================

// strategy() must be the FIRST statement, so it cannot reference input.* declared
// below. The backtest-cost values here are therefore literals (framework config,
// not strategy-logic tunables) and are documented inline. All trading-LOGIC
// parameters are exposed as input.* in Section 1.
strategy(
     title                   = "NIFTY FUT 5m — Options Directional (A: breakout)",
     shorttitle              = "NF5m-A",
     overlay                 = true,
     pyramiding              = 0,                              // one position at a time
     calc_on_every_tick      = false,                         // evaluate on bar data, not ticks
     process_orders_on_close = true,                          // fills modelled at bar close (anti-repaint friendly)
     initial_capital         = 100000,                        // INR 1,00,000 nominal
     default_qty_type        = strategy.fixed,                // fixed contracts so R is comparable across runs
     default_qty_value       = 1,                             // 1 futures contract
     commission_type         = strategy.commission.percent,   // mild realistic cost proxy
     commission_value        = 0.03,                          // 0.03% per order
     slippage                = 2,                             // 2 ticks (NIFTY fut tick = 0.05 -> 0.10 pts)
     currency                = currency.INR,
     max_labels_count        = 500,                           // cap drawing objects (Section 7 deletes stale ones)
     max_lines_count         = 500,
     close_entries_rule      = "ANY")

// =============================================================================
// === 1. INPUTS ===
// Every trading-logic tunable lives here with group + tooltip. No magic numbers
// in logic. NOTE on the <=8 optimisable-edge-param budget: only the CONTINUOUS
// edge params count toward it -> emaFast, emaSlow, atrMult, rrTarget, breakoutN,
// minAtr. Structural/config inputs (biasRef, sessions, display, etc.) are NOT to
// be curve-fitted and do not count.
// =============================================================================

// --- group labels (single source of truth; plain literal assignment keeps them
//     const-qualified, as input()'s group= requires) ---
GRP_SESSION = "Session"
GRP_BIAS    = "Bias (GATE 1)"
GRP_TRIGGER = "Trigger (GATE 2)"
GRP_RISK    = "Risk (GATE 3 + exits)"
GRP_DISPLAY = "Display"
GRP_ALERTS  = "Alerts"

// --- Session ---
inTz           = input.string("Asia/Kolkata", "Timezone", group = GRP_SESSION,
     tooltip = "IANA timezone for all session windows. NIFTY trades in IST = Asia/Kolkata.")
inSessTrade    = input.session("0920-1510", "Trading session", group = GRP_SESSION,
     tooltip = "Bars inside this window are eligible for the strategy. Default 09:20-15:10 IST.")
inSessEntry    = input.session("0920-1445", "New-entry window", group = GRP_SESSION,
     tooltip = "NEW entries only allowed inside this window. Default 09:20-14:45 (no fresh entries after 14:45).")
inSessFlat     = input.session("1515-1530", "Force-flat window", group = GRP_SESSION,
     tooltip = "Any open position is force-closed once a bar falls in this window. Default 15:15-15:30.")
inSkipOpenBars = input.int(2, "Skip first N session bars", minval = 0, group = GRP_SESSION,
     tooltip = "Skip the first N bars after the session opens to avoid opening-auction noise. Default 2.")

// --- Bias (GATE 1) ---
inEmaFast = input.int(9, "EMA fast length", minval = 1, group = GRP_BIAS,
     tooltip = "Fast EMA. Long-bias needs emaFast > emaSlow; short-bias the reverse. [edge param]")
inEmaSlow = input.int(21, "EMA slow length", minval = 2, group = GRP_BIAS,
     tooltip = "Slow EMA. Must be > emaFast for a meaningful cross. [edge param]")
inBiasRef = input.string("VWAP", "Bias reference", options = ["VWAP", "SessionAvg", "EMA-only"], group = GRP_BIAS,
     tooltip = "Price reference for the bias gate. VWAP = use session VWAP (auto-falls back to SessionAvg when " +
       "session volume is na/0). SessionAvg = session-anchored mean of the bias source (volume-free). " +
       "EMA-only = drop the price-vs-reference term entirely.")
inBiasSrc = input.source(hlc3, "Bias price source", group = GRP_BIAS,
     tooltip = "Source feeding VWAP / SessionAvg. Default hlc3 (typical price).")

// --- Trigger (GATE 2) ---
inTriggerMode = input.string("breakout", "Trigger mode", options = ["breakout", "pullback"], group = GRP_TRIGGER,
     tooltip = "Momentum trigger in the bias direction. This file (Variant A) defaults to 'breakout'. " +
       "Exactly one mode is active per run.")
inBreakoutN   = input.int(10, "Breakout lookback N", minval = 1, group = GRP_TRIGGER,
     tooltip = "Breakout trigger fires when close breaks the prior N-bar high (CE) / low (PE). Default 10. [edge param]")
inPullbackAtr = input.float(0.25, "Pullback tag tolerance (ATR)", minval = 0.0, step = 0.05, group = GRP_TRIGGER,
     tooltip = "Pullback mode: how close (in ATR units) price must tag emaFast to count as a pullback. Default 0.25.")

// --- Risk (GATE 3 + exits) ---
inAtrLen       = input.int(14, "ATR length", minval = 1, group = GRP_RISK,
     tooltip = "ATR period for stop sizing and volatility filters. Default 14.")
inAtrMult      = input.float(1.2, "ATR stop multiple", minval = 0.1, step = 0.1, group = GRP_RISK,
     tooltip = "Initial stop distance = atrMult * ATR from entry. Default 1.2. [edge param]")
inRrTarget     = input.float(2.0, "Reward:Risk target", minval = 0.5, step = 0.1, group = GRP_RISK,
     tooltip = "Target = entry +/- rrTarget * R, where R = |entry - stop|. Min 1:2 mandated -> default 2.0. [edge param]")
inMinAtr       = input.float(0.0, "Min ATR (skip dead range)", minval = 0.0, step = 0.5, group = GRP_RISK,
     tooltip = "Block entries when ATR < this (dead market). 0 = disabled. Tune per instrument scale. [edge param]")
inMaxAtr       = input.float(0.0, "Max ATR (skip whipsaw, 0=off)", minval = 0.0, step = 0.5, group = GRP_RISK,
     tooltip = "Optional: block entries when ATR > this (news whipsaw). 0 = disabled.")
inUseStructStop = input.bool(true, "Use structural stop", group = GRP_RISK,
     tooltip = "If on, the stop is the WIDER of (atrMult*ATR) and the trigger-bar extreme, giving structure room.")
inArmTrailR    = input.float(1.0, "Trail arms at +R", minval = 0.1, step = 0.1, group = GRP_RISK,
     tooltip = "Once price reaches +N*R, stop moves to breakeven then trails by atrMult*ATR. Default 1.0 (=+1R).")

// --- Display ---
inShowEmas      = input.bool(true,  "Show EMAs", group = GRP_DISPLAY,
     tooltip = "Plot emaFast / emaSlow for visual context.")
inShowBiasRef   = input.bool(true,  "Show bias reference", group = GRP_DISPLAY,
     tooltip = "Plot the resolved bias reference (VWAP or SessionAvg).")
inShowSessionBg = input.bool(false, "Shade trading session", group = GRP_DISPLAY,
     tooltip = "Tint the background during the trading session window.")
inShowDebug     = input.bool(false, "Show debug panel + data-window series", group = GRP_DISPLAY,
     tooltip = "Show a parameter panel and push internal series to the Data Window for verification.")
inWarnTf        = input.bool(true,  "Warn if chart TF != expected", group = GRP_DISPLAY,
     tooltip = "Show a warning label when the chart timeframe differs from the expected minutes below.")
inExpectedTfMin = input.int(5, "Expected timeframe (minutes)", minval = 1, group = GRP_DISPLAY,
     tooltip = "Timeframe this strategy is designed for. Default 5 (minutes).")

// --- Alerts ---
inAlertTag = input.string("NIFTY FUT", "Alert symbol label", group = GRP_ALERTS,
     tooltip = "Text label inserted into alert messages so webhooks know the instrument.")

// =============================================================================
// === 2. INDICATORS / DATA ===
// Single-responsibility data layer. Helper functions first (encapsulated state /
// pure where possible, per CLAUDE.md §5), then the session-independent series.
// =============================================================================

// f_barCount: bars elapsed since the caller-supplied reset (isNew). Encapsulated
// `var` state, one instance per call site. Resets to 1 on the reset bar, then
// increments while isIn is true.
f_barCount(bool isNew, bool isIn) =>
    var int n = 0
    if isNew
        n := 1
    else if isIn
        n := n + 1
    n

// f_sessionAgg: volume-FREE running mean of `src` since the caller-supplied reset
// (isNew) — a VWAP proxy that survives volume-less feeds — plus the running volume
// sum used to test whether the feed's volume is real. Encapsulated `var` state;
// resets on isNew, accumulates while isIn. Returns [mean, volumeSum]; div-by-zero guarded.
f_sessionAgg(float src, float vol, bool isNew, bool isIn) =>
    var float s    = na
    var int   c    = 0
    var float vsum = na
    if isNew
        s    := src
        c    := 1
        vsum := nz(vol)
    else if isIn
        s    := nz(s) + src
        c    := c + 1
        vsum := nz(vsum) + nz(vol)
    [c > 0 ? s / c : na, vsum]

// f_resolveBiasRef: PURE. Picks the GATE-1 price reference. "VWAP" uses true VWAP
// only when volume is reliable, else falls back to the volume-free mean. "EMA-only"
// returns na so the bias gate drops the price-vs-reference term entirely.
f_resolveBiasRef(string mode, float vwapV, float sessAvgV, bool volOk) =>
    switch mode
        "SessionAvg" => sessAvgV
        "EMA-only"   => na
        => volOk and not na(vwapV) ? vwapV : sessAvgV

// --- session-independent series (each computed ONCE, unconditionally, so the
//     accumulating built-in ta.vwap stays correct) ---
emaFast = ta.ema(close, inEmaFast)
emaSlow = ta.ema(close, inEmaSlow)
atrVal  = ta.atr(inAtrLen)

// Raw session VWAP. Requires volume; returns na on a volume-less feed (handled in
// Section 3 via the SessionAvg fallback). Anchors to session start internally.
vwapRaw = ta.vwap(inBiasSrc)

// =============================================================================
// === 3. SESSION & FILTERS ===
// Trade-eligibility windows, the trading-DAY anchor (shared by VWAP + the SessionAvg
// fallback), day-anchored aggregates + volume reliability, and the resolved bias
// reference. No trade decisions here — just the booleans/series the gates consume.
// =============================================================================

// --- trade-eligibility session windows (na outside the window) ---
inSession     = not na(time(timeframe.period, inSessTrade, inTz))   // 09:20-15:10 entry-eligible window
inEntryWindow = not na(time(timeframe.period, inSessEntry, inTz))   // 09:20-14:45 new-entry window
inFlatWindow  = not na(time(timeframe.period, inSessFlat,  inTz))   // 15:15-15:30 force-flat window

// --- trading-DAY anchor: true on the first intraday bar of each new day, i.e. the
//     first bar at/after the session open (~09:15 IST). This MATCHES ta.vwap's own
//     per-day reset, so VWAP and the SessionAvg fallback share ONE anchor. ---
isNewDay = timeframe.change("1D")

// --- bars since the trading day opened. skipOpenBars counts from the 09:15 open
//     (STRATEGY_SPEC: "skips 09:15-09:25"); accumulate every bar, reset on isNewDay ---
barsInDay      = f_barCount(isNewDay, true)
afterOpenNoise = inSession and barsInDay > inSkipOpenBars

// --- day-anchored aggregates (full day, exactly like VWAP): volume-free mean +
//     volume sum. On a regular-session feed every bar belongs to the day, so
//     accumulating every bar between isNewDay resets mirrors ta.vwap. ---
[sessAvg, cumVol] = f_sessionAgg(inBiasSrc, volume, isNewDay, true)
// feed has real volume this day? -> selects true VWAP vs the SessionAvg fallback
volReliable = not na(cumVol) and cumVol > 0

// --- resolved bias reference (true VWAP when volume reliable, else SessionAvg) ---
biasRefPrice = f_resolveBiasRef(inBiasRef, vwapRaw, sessAvg, volReliable)
// active-source code for verification: 1 = VWAP, 0 = SessionAvg, -1 = EMA-only
activeSrcCode = inBiasRef == "EMA-only" ? -1.0 : inBiasRef == "SessionAvg" ? 0.0 : (volReliable and not na(vwapRaw) ? 1.0 : 0.0)

// --- timeframe sanity warning (managed label; stale deleted each last bar) ---
tfMismatch = inWarnTf and timeframe.in_seconds() != inExpectedTfMin * 60
var label tfLbl = na
if barstate.islast
    label.delete(tfLbl)
    if tfMismatch
        tfLbl := label.new(bar_index, high, "WARN: chart TF != " + str.tostring(inExpectedTfMin) +
             "m. Strategy is designed for " + str.tostring(inExpectedTfMin) + "m.",
             style = label.style_label_down, color = color.orange, textcolor = color.white, size = size.small)

// =============================================================================
// === 4. SIGNAL LOGIC (GATES) ===
// Phase 2: GATE 1 (bias) / GATE 2 (trigger: breakout|pullback) / GATE 3 (context).
// All evaluated on CONFIRMED bars only -> non-repainting. No code yet.
// =============================================================================

// =============================================================================
// === 5. RISK & EXITS ===
// Phase 3: ATR/structural stop, R, rrTarget, breakeven+trail at +R, time stop,
// opposite-flip exit. No code yet.
// =============================================================================

// =============================================================================
// === 6. ORDERS ===
// Phase 3: strategy.entry / strategy.exit / strategy.close wiring. No code yet.
// =============================================================================

// =============================================================================
// === 7. PLOTTING ===
// Context plots now; BUY/EXIT labels + stop/target lines arrive in Phase 3.
// =============================================================================
// EMAs are not session-anchored -> plot continuously.
plot(inShowEmas ? emaFast : na, "EMA fast", color = color.new(color.aqua,   0), linewidth = 1)
plot(inShowEmas ? emaSlow : na, "EMA slow", color = color.new(color.orange, 0), linewidth = 1)
// Bias ref IS day-anchored -> plot na on the first bar of each new day so no
// vertical connector is drawn across the anchor reset. Line resumes next bar.
plot((inShowBiasRef and not isNewDay) ? biasRefPrice : na, "Bias ref", color = color.new(color.fuchsia, 0), linewidth = 2)

bgcolor(inShowSessionBg and inSession ? color.new(color.blue, 92) : na, title = "Session shade")

// --- debug series -> Data Window only (no chart clutter), gated by toggle ---
plot(inShowDebug ? biasRefPrice                : na, "dbg biasRef",    display = display.data_window)
plot(inShowDebug ? activeSrcCode               : na, "dbg activeSrc 1=VWAP 0=SessAvg -1=EMA", display = display.data_window)
plot(inShowDebug ? vwapRaw                     : na, "dbg vwapRaw",    display = display.data_window)
plot(inShowDebug ? sessAvg                     : na, "dbg SessAvg",    display = display.data_window)
plot(inShowDebug ? (volReliable   ? 1 : 0)     : na, "dbg volReliable",display = display.data_window)
plot(inShowDebug ? (isNewDay      ? 1 : 0)     : na, "dbg isNewDay",   display = display.data_window)
plot(inShowDebug ? atrVal                      : na, "dbg ATR",        display = display.data_window)
plot(inShowDebug ? barsInDay                   : na, "dbg barsInDay",  display = display.data_window)
plot(inShowDebug ? (inSession     ? 1 : 0)     : na, "dbg inSession",  display = display.data_window)
plot(inShowDebug ? (inEntryWindow ? 1 : 0)     : na, "dbg inEntryWin", display = display.data_window)
plot(inShowDebug ? (inFlatWindow  ? 1 : 0)     : na, "dbg inFlatWin",  display = display.data_window)
plot(inShowDebug ? (afterOpenNoise? 1 : 0)     : na, "dbg afterOpen",  display = display.data_window)

// --- parameter echo panel (verifies "zero magic numbers"; references all
//     not-yet-wired inputs so the scaffold has no unused-variable warnings) ---
var table dbgT = na
if inShowDebug and barstate.islast
    if na(dbgT)
        dbgT := table.new(position.top_right, 2, 15, border_width = 1)
    activeSrcStr = inBiasRef == "EMA-only" ? "EMA-only" : inBiasRef == "SessionAvg" ? "SessionAvg" : (volReliable ? "VWAP" : "SessionAvg (fallback)")
    table.cell(dbgT, 0, 0,  "PARAM",        bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(dbgT, 1, 0,  "VALUE",        bgcolor = color.gray, text_color = color.white, text_size = size.small)
    table.cell(dbgT, 0, 1,  "Trigger",      text_size = size.small)
    table.cell(dbgT, 1, 1,  inTriggerMode,  text_size = size.small)
    table.cell(dbgT, 0, 2,  "Breakout N",   text_size = size.small)
    table.cell(dbgT, 1, 2,  str.tostring(inBreakoutN), text_size = size.small)
    table.cell(dbgT, 0, 3,  "Pullback ATR", text_size = size.small)
    table.cell(dbgT, 1, 3,  str.tostring(inPullbackAtr), text_size = size.small)
    table.cell(dbgT, 0, 4,  "ATR len",      text_size = size.small)
    table.cell(dbgT, 1, 4,  str.tostring(inAtrLen), text_size = size.small)
    table.cell(dbgT, 0, 5,  "ATR mult",     text_size = size.small)
    table.cell(dbgT, 1, 5,  str.tostring(inAtrMult), text_size = size.small)
    table.cell(dbgT, 0, 6,  "R:R target",   text_size = size.small)
    table.cell(dbgT, 1, 6,  str.tostring(inRrTarget), text_size = size.small)
    table.cell(dbgT, 0, 7,  "Min ATR",      text_size = size.small)
    table.cell(dbgT, 1, 7,  str.tostring(inMinAtr), text_size = size.small)
    table.cell(dbgT, 0, 8,  "Max ATR",      text_size = size.small)
    table.cell(dbgT, 1, 8,  str.tostring(inMaxAtr), text_size = size.small)
    table.cell(dbgT, 0, 9,  "Struct stop",  text_size = size.small)
    table.cell(dbgT, 1, 9,  str.tostring(inUseStructStop), text_size = size.small)
    table.cell(dbgT, 0, 10, "Trail @ +R",   text_size = size.small)
    table.cell(dbgT, 1, 10, str.tostring(inArmTrailR), text_size = size.small)
    table.cell(dbgT, 0, 11, "Bias ref",     text_size = size.small)
    table.cell(dbgT, 1, 11, inBiasRef,      text_size = size.small)
    table.cell(dbgT, 0, 12, "Alert tag",    text_size = size.small)
    table.cell(dbgT, 1, 12, inAlertTag,     text_size = size.small)
    table.cell(dbgT, 0, 13, "Active src",   bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(dbgT, 1, 13, activeSrcStr,   bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(dbgT, 0, 14, "Vol reliable", bgcolor = color.new(color.teal, 60), text_size = size.small)
    table.cell(dbgT, 1, 14, str.tostring(volReliable), bgcolor = color.new(color.teal, 60), text_size = size.small)
else if not inShowDebug and not na(dbgT)
    table.delete(dbgT)
    dbgT := na

// =============================================================================
// === 8. ALERTS ===
// Phase 3: alertcondition()/alert() for BUY CE / BUY PE / EXIT CE / EXIT PE,
// messages tagged with inAlertTag + price + reason. No code yet.
// =============================================================================
