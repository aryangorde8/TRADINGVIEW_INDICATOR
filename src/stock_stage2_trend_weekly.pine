//@version=6
// =============================================================================
// STOCK STAGE-2 TREND RIDER (WEEKLY chart, CASH EQUITY, long-only)
// -----------------------------------------------------------------------------
// PURPOSE  : Position-trading system (NOT a day/swing system): ride Stage-2
//            uptrends for months-to-years on the WEEKLY chart. Run this
//            script on the 1W timeframe — the logic assumes weekly bars.
// EDGE     : Stan Weinstein's Stage Analysis, mechanised: enter when a stock
//            breaks to a new 52-week closing high while above a RISING
//            30-week SMA (Stage-2 breakout); stay in until the weekly close
//            falls back below the 30-week SMA (Stage-3/4 transition).
//            No profit target — the whole edge is letting winners run.
// TESTED   : replicated in-house against the pinned data_cache/ snapshot
//            (committed at results/backtests/), 39 NSE large caps, ~29y
//            weekly data, 0.25%/side, full-equity single position:
//            - round-1 universe: pooled PF 3.53 (CI 2.11-5.82), 383 trades,
//              no fragility warnings
//            - OOS universe:     pooled PF 3.77 (CI 1.27-9.85), 355 trades;
//              the fragility auditor FLAGS concentrated + decaying edge
//            - survives top-3 removal (2.60 / 1.57), above the PF>=1.5 bar
//            PASSED its pre-registered bar (PF>=1.5 both universes, CI>1,
//            top-3 survival) — the first candidate in this project to do so.
// CAVEATS  : (1) full-equity compounding weights recent trades: the
//            era-honest PF is the second-half figure ~2.0-2.8, still well
//            above the bar. (2) median WINNER is held ~9-10 months; ~28% of
//            winners exceed 1 year (LTCG applies to those) — losers exit in
//            weeks by design; a system forcing >1yr holds on losers would be
//            far worse. (3) universe = today's large caps tested backwards
//            (survivorship) — inflation strongest for trend systems; the
//            true test is forward paper-trading. (4) SMA30 exits give back
//            a chunk of open profit in crashes; that giveback IS the system.
// SIZING   : one position per symbol, full equity of the per-symbol account
//            (or your portfolio slot). Portfolio use: run across a fixed
//            liquid watchlist; expect <1 trade per name per year.
// COSTS    : 0.25%/side commission (matches the Python replication's all-in
//            0.25%/side that produced the PF figures above), PLUS ~5 ticks
//            slippage modelled separately here — so this Pine backtest is
//            marginally MORE conservative than the replication, not less.
//            NON-REPAINT: weekly confirmed-bar closes only; no
//            request.security; fills at bar close.
// DO NOT   : tune the 52/30/4 lengths — they are the literature-standard,
//            tested config. A failed forward test rejects the system.
// =============================================================================
strategy(
     title                   = "Stock Stage-2 Trend Rider (weekly, long-only)",
     shorttitle              = "Stage2W",
     overlay                 = true,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     initial_capital         = 1000000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.25,                  // matches replication (0.25%/side all-in)
     slippage                = 5,                     // ~extra realism on top; do not remove
     currency                = currency.INR,
     max_labels_count        = 500)

// =============================================================================
// === 1. INPUTS (tested config — structural, not for optimisation) ===
// =============================================================================
GRP = "Stage-2 config (tested — do not optimise)"
inAnchorLen = input.int(52, "New-high lookback (weeks)", minval = 12, group = GRP)
inSmaLen    = input.int(30, "Trend SMA (weeks)", minval = 5, group = GRP)
inRisingLen = input.int(4, "SMA rising vs N weeks ago", minval = 1, group = GRP)
inShowUi    = input.bool(true, "Show labels + regime table", group = "Display")

// =============================================================================
// === 2. LOGIC (weekly confirmed closes) ===
// =============================================================================
sma30  = ta.sma(close, inSmaLen)
anchor = ta.highest(close[1], inAnchorLen)
rising = sma30 > sma30[inRisingLen]

stage2Break = close > anchor and close > sma30 and rising
inStage2    = close > sma30 and rising

doEnter = stage2Break and strategy.position_size == 0
if doEnter
    strategy.entry("L", strategy.long)
    if inShowUi
        label.new(bar_index, na,
             text = "STAGE-2 BUY " + str.tostring(close, format.mintick)
                  + "\nexit: weekly close < SMA" + str.tostring(inSmaLen),
             yloc = yloc.belowbar, style = label.style_label_up,
             color = color.new(color.green, 10), textcolor = color.white,
             size = size.small)

if strategy.position_size > 0 and close < sma30
    strategy.close("L", comment = "stage3/4: close < SMA30w")

// =============================================================================
// === 3. DISPLAY ===
// =============================================================================
plot(sma30, "SMA 30w", color = color.new(color.teal, 0), linewidth = 2)
plot(anchor, "52w-high anchor", color = color.new(color.purple, 40))
bgcolor(inShowUi ? (inStage2 ? color.new(color.teal, 94) : color.new(color.red, 94)) : na, title = "Stage tint")

var table rt = table.new(position.top_right, 1, 3)
if inShowUi and barstate.islast
    wrongTf = not timeframe.isweekly
    table.cell(rt, 0, 0,
         wrongTf ? "SET CHART TO 1W — logic assumes weekly bars"
             : inStage2 ? "STAGE 2 — uptrend, ride/watch" : "NOT STAGE 2 — cash / no entry",
         bgcolor = wrongTf ? color.new(color.orange, 10) : inStage2 ? color.new(color.green, 15) : color.new(color.red, 15),
         text_color = color.white, text_size = size.small)
    distPct = (anchor - close) / close * 100
    table.cell(rt, 0, 1, close > anchor ? "AT/ABOVE 52W HIGH" : str.tostring(distPct, "#.#") + "% below 52w high",
         bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
    table.cell(rt, 0, 2, strategy.position_size > 0 ? "IN POSITION — hold while close > SMA30w" : "FLAT — waiting for Stage-2 breakout",
         bgcolor = strategy.position_size > 0 ? color.new(color.blue, 30) : color.new(color.gray, 50),
         text_color = color.white, text_size = size.small)

// =============================================================================
// === 4. ALERTS ===
// =============================================================================
alertcondition(doEnter, title = "STAGE2 BUY", message = "STAGE2 BUY {{ticker}} @ {{close}}")
alertcondition(strategy.position_size > 0 and close < sma30, title = "STAGE2 EXIT", message = "STAGE2 EXIT {{ticker}} @ {{close}}")
