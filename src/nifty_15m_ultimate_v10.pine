//@version=6
// ╔══════════════════════════════════════════════════════════════════════╗
// ║  NIFTY 15M ULTIMATE v10 — Best Model                                ║
// ║  Indicators: Supertrend · LSMA · BB Squeeze · ADX · CMF · VWAP     ║
// ║  SL: Chandelier Exit (structural, not arbitrary ATR multiple)       ║
// ║  TP: 2R and 3.5R from structural SL                                 ║
// ║  Quality /3 : Squeeze + ADX velocity + CMF (predict BIG moves)     ║
// ║  Fix: Trade tracks real best price → correct TP hit detection       ║
// ║  Fix: SL trails to breakeven after TP1 → big wins, small losses     ║
// ║  Fix (harness): qty was percent_of_equity=2 with default 1M capital ║
// ║    -> <1 contract -> rounded to 0 -> ZERO trades. Now fixed qty=1   ║
// ║    on initial_capital=1cr so a NIFTY1! contract is affordable.      ║
// ╚══════════════════════════════════════════════════════════════════════╝

strategy("NIFTY 15M Ultimate v10", overlay=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=2, max_bars_back=500, max_labels_count=500, max_lines_count=500, process_orders_on_close=true)

// ════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════

i_st_f   = input.float(2.5,  "ST Factor",          step=0.5, minval=1.0,  tooltip="2.5 optimal for Nifty 15m.", group="① Supertrend")
i_st_a   = input.int  (10,   "ST ATR Period",       minval=5,              group="① Supertrend")
i_lsma_l = input.int  (20,   "LSMA Length (trend)",  minval=5,             tooltip="Least Squares MA — low lag trend filter alongside Supertrend.", group="② LSMA Trend")
i_adx_l  = input.int  (14,   "ADX Length",                                 group="③ ADX")
i_adx_t  = input.float(20.0, "ADX Minimum",        step=1.0,              tooltip="<20=chop. 20-25=trend. >25=strong trend.", group="③ ADX")
i_cmf_l  = input.int  (20,   "CMF Length (money flow)", minval=5,          tooltip="Chaikin Money Flow — detects institutional buying/selling pressure.", group="④ CMF Volume")
i_bb_l   = input.int  (20,   "BB/Squeeze Length",   minval=5,              tooltip="Used for Bollinger Bands AND Keltner Channels (same base). Squeeze = BB inside KC.", group="⑤ BB Squeeze")
i_bb_m   = input.float(2.0,  "BB Multiplier",       step=0.1,              group="⑤ BB Squeeze")
i_kc_m   = input.float(1.5,  "KC Multiplier",       step=0.1,              tooltip="Squeeze = BB upper < KC upper AND BB lower > KC lower. Release = big move imminent.", group="⑤ BB Squeeze")
i_ch_l   = input.int  (22,   "Chandelier Lookback", minval=5,              tooltip="Chandelier Exit: SL placed ATR below highest high (CE) or above lowest low (PE).\nThis is structural — the market has to move past a real level to stop you.", group="⑥ Chandelier SL")
i_ch_m   = input.float(2.0,  "Chandelier ATR Mult", step=0.1,              group="⑥ Chandelier SL")
i_rr1    = input.float(2.0,  "TP1 R:R",            step=0.25,             tooltip="TP1 = SL distance × 2.0. After TP1 hit, SL moves to breakeven.", group="⑦ Targets")
i_rr2    = input.float(3.5,  "TP2 R:R",            step=0.25,             tooltip="TP2 = SL distance × 3.5. Stay in trade until ST flip or TP2.", group="⑦ Targets")
i_atr_l  = input.int  (14,   "ATR Period",                                 group="⑦ Targets")
i_show_st = input.bool(true, "Supertrend line",                            group="⑧ Display")
i_show_vw = input.bool(true, "VWAP",                                       group="⑧ Display")
i_show_bb = input.bool(true, "Bollinger Bands",                            group="⑧ Display")
i_show_tp = input.bool(true, "SL / TP lines",                              group="⑧ Display")
i_show_bk = input.bool(true, "Blocked dots",                               group="⑧ Display")

// ════════════════════════════════════════════════════════════════════════
// SESSION
// ════════════════════════════════════════════════════════════════════════

new_day    = timeframe.change("D")
in_session = (hour > 9 or (hour == 9 and minute >= 30)) and (hour < 14 or (hour == 14 and minute <= 30))
is_expiry  = dayofweek == dayofweek.thursday

// ════════════════════════════════════════════════════════════════════════
// VWAP — session-reset institutional benchmark
// ════════════════════════════════════════════════════════════════════════

var float _cs = 0.0
var float _cv = 0.0
if new_day
    _cs := 0.0
    _cv := 0.0
_cs  += hlc3 * volume
_cv  += volume
vwap  = _cs / _cv

// ════════════════════════════════════════════════════════════════════════
// ATR
// ════════════════════════════════════════════════════════════════════════

atr = ta.atr(i_atr_l)

// ════════════════════════════════════════════════════════════════════════
// SUPERTREND — primary trigger
// ════════════════════════════════════════════════════════════════════════

[st_val, _stdir] = ta.supertrend(i_st_f, i_st_a)
st_bull = close > st_val
st_bear = close < st_val
st_up   = ta.crossover (close, st_val)
st_dn   = ta.crossunder(close, st_val)

// ════════════════════════════════════════════════════════════════════════
// LSMA (Least Squares Moving Average) — low-lag trend confirmation
// Much more responsive than SMA/EMA, reduces fake crossovers
// ════════════════════════════════════════════════════════════════════════

lsma      = ta.linreg(close, i_lsma_l, 0)
lsma_bull = close > lsma
lsma_bear = close < lsma

// ════════════════════════════════════════════════════════════════════════
// ADX + DMI — trend strength + direction
// adx_rising = ADX higher than 3 bars ago = trend ACCELERATING
// This is the predictor of sustained large moves
// ════════════════════════════════════════════════════════════════════════

[_dip, _dim, adx] = ta.dmi(i_adx_l, i_adx_l)
adx_ok     = adx >= i_adx_t
adx_strong = adx >= 25.0
adx_rising = adx > adx[3]    // Accelerating: now predicts size, not just existence

// ════════════════════════════════════════════════════════════════════════
// BOLLINGER BANDS + KELTNER CHANNEL SQUEEZE
//
//  The single most important addition for catching BIG missed moves.
//  When BB contracts inside KC = market is coiling like a spring.
//  When BB expands beyond KC = spring released → large directional move.
//
//  This is why some 1-star trades gave 200pts before:
//  Those were squeeze breakouts. In v10 they correctly score ★1.
// ════════════════════════════════════════════════════════════════════════

bb_basis = ta.sma(close, i_bb_l)
bb_dev_v = ta.stdev(close, i_bb_l)
bb_upper = bb_basis + i_bb_m * bb_dev_v
bb_lower = bb_basis - i_bb_m * bb_dev_v
bb_width = (bb_upper - bb_lower) / bb_basis   // Normalized width

kc_basis  = ta.ema(close, i_bb_l)
kc_upper  = kc_basis + i_kc_m * atr
kc_lower  = kc_basis - i_kc_m * atr

in_squeeze  = bb_upper < kc_upper and bb_lower > kc_lower    // Coiling
squeeze_off = not in_squeeze and in_squeeze[1]                // Spring released!

// ════════════════════════════════════════════════════════════════════════
// CHAIKIN MONEY FLOW (CMF) — institutional conviction
//
//  CMF > +0.05 : net buying pressure (institutions accumulating)
//  CMF < -0.05 : net selling pressure (institutions distributing)
//  CMF > +0.15 : strong conviction → contributes to ★3
// ════════════════════════════════════════════════════════════════════════

_mfm = high == low ? 0.0 : ((close - low) - (high - close)) / (high - low)
_mfv = _mfm * volume
cmf  = ta.sma(_mfv, i_cmf_l) / ta.sma(volume, i_cmf_l)
cmf_bull = cmf > 0.05
cmf_bear = cmf < -0.05

// ════════════════════════════════════════════════════════════════════════
// VOLUME
// ════════════════════════════════════════════════════════════════════════

vol_ma  = ta.sma(volume, 20)
vol_ok  = volume > vol_ma * 1.3
vol_pct = math.round(volume / vol_ma * 100)

// ════════════════════════════════════════════════════════════════════════
// HTF (1H Supertrend) — quality factor only, never blocks entry
// Returns int to avoid Pine Script na(bool) type error
// ════════════════════════════════════════════════════════════════════════

htf_1h_fn() =>
    [st1h, _st1hd] = ta.supertrend(2.5, 10)
    close > st1h ? 1 : 0

htf_raw  = request.security(syminfo.tickerid, "60", htf_1h_fn(), lookahead=barmerge.lookahead_off)
htf_bull = nz(htf_raw, 1) >= 1

// ════════════════════════════════════════════════════════════════════════
// CHANDELIER EXIT — structural SL placement
//
//  Old v9: SL at swing low minus buffer (arbitrary)
//  v10: SL at Chandelier Exit level
//       = highest(high, 22) - 2×ATR for CE
//       = lowest(low, 22) + 2×ATR for PE
//  This is a professional-grade trailing stop anchor, not an ATR multiple.
//  The "highest high of 22 bars" is the actual market structure reference.
// ════════════════════════════════════════════════════════════════════════

chan_hi = ta.highest(high, i_ch_l)
chan_lo = ta.lowest (low,  i_ch_l)

// Raw Chandelier SL levels
ce_chan_sl   = chan_hi - i_ch_m * atr
pe_chan_sl   = chan_lo  + i_ch_m * atr

// Clamp: SL between 0.7× and 2.5× ATR from entry
// Prevents SL being impossibly tight or catastrophically wide
ce_raw_d = close - ce_chan_sl
ce_sl_d  = math.max(atr * 0.7, math.min(atr * 2.5, ce_raw_d))
ce_sl_at_entry = close - ce_sl_d   // Computed at entry bar

pe_raw_d = pe_chan_sl - close
pe_sl_d  = math.max(atr * 0.7, math.min(atr * 2.5, pe_raw_d))
pe_sl_at_entry = close + pe_sl_d   // Computed at entry bar

// ════════════════════════════════════════════════════════════════════════
// RANGE BREAKOUT — second entry path
// Catches moves that start as range expansions before full ST flip
// ════════════════════════════════════════════════════════════════════════

rng_hi  = ta.highest(high, 20)[1]
rng_lo  = ta.lowest (low,  20)[1]
bull_brk = ta.crossover (close, rng_hi) and st_bull and vol_ok and adx_ok
bear_brk = ta.crossunder(close, rng_lo)  and st_bear and vol_ok and adx_ok

// ════════════════════════════════════════════════════════════════════════
// SIGNAL QUALITY — REDESIGNED TO PREDICT MOVE SIZE
//
//  OLD PROBLEM: 1★ trade gives 200pts, 3★ gives 30pts.
//  ROOT CAUSE:  Stars were based on static conditions (ADX, VWAP, vol)
//               None of these predict MAGNITUDE, only direction.
//
//  v10 FIX — each star is a direct predictor of large moves:
//
//  ★1  Squeeze active/releasing in correct direction
//      WHY: Compressed volatility = spring loaded = BIG release incoming
//      This is what 200pt "1-star" trades were before. Now correctly ★1+.
//
//  ★2  ADX > 25 AND adx_rising (accelerating trend, not just existing)
//      WHY: ADX > 25 alone = trend exists. Rising = trend gaining speed.
//           Speed = larger moves per bar = bigger profit.
//
//  ★3  Vol > 1.3× AND CMF confirms (institutional conviction)
//      WHY: Large volume + positive CMF = big players are IN.
//           Where big players go, price follows far and fast.
//
//  RESULT: ★★★ = squeeze firing + ADX accelerating + institutions buying/selling
//          These are the trades that give 150-300pts on Nifty.
// ════════════════════════════════════════════════════════════════════════

// CE quality
ce_q1 = (squeeze_off or in_squeeze) and st_bull ? 1 : 0   // ★1 squeeze
ce_q2 = adx_strong and adx_rising ? 1 : 0                  // ★2 ADX velocity
ce_q3 = vol_ok and cmf_bull ? 1 : 0                        // ★3 institutions
ce_q  = ce_q1 + ce_q2 + ce_q3

// PE quality
pe_q1 = (squeeze_off or in_squeeze) and st_bear ? 1 : 0   // ★1 squeeze
pe_q2 = adx_strong and adx_rising ? 1 : 0                  // ★2 ADX velocity
pe_q3 = vol_ok and cmf_bear ? 1 : 0                        // ★3 institutions
pe_q  = pe_q1 + pe_q2 + pe_q3

ce_grade = ce_q == 3 ? "★★★  FULL  huge move expected" : ce_q == 2 ? "★★   HALF  good setup" : "★    TINY  ADX gate only"
pe_grade = pe_q == 3 ? "★★★  FULL  huge move expected" : pe_q == 2 ? "★★   HALF  good setup" : "★    TINY  ADX gate only"

// ════════════════════════════════════════════════════════════════════════
// STATE MACHINE
//   state = 0: FLAT | 1: IN CE | -1: IN PE
//
//   CRITICAL FIXES in v10:
//   1. trade_best: tracks actual highest/lowest price seen during trade
//      → correct TP hit detection (no more false "TP2 reached")
//   2. active_sl: trails to breakeven after TP1 hit
//      → protects profits, implements "big wins, small losses"
//   3. Sync with strategy: if SL hits, state resets on next bar
// ════════════════════════════════════════════════════════════════════════

var int   state       = 0
var float ep          = na
var float e_sl        = na     // Initial structural SL
var float e_tp1       = na     // TP1 level
var float e_tp2       = na     // TP2 level
var float e_risk      = na     // Risk distance (for display)
var float active_sl   = na     // Current live SL (may trail to breakeven)
var float trade_best  = na     // REAL best price during trade (for TP detection)
var bool  tp1_reached = false  // Whether TP1 was actually hit

// ── Track best price and trail SL ─────────────────────────────────────
if state == 1
    trade_best := na(trade_best) ? high : math.max(trade_best, high)
    // After TP1 genuinely reached, trail SL to breakeven
    if not na(e_tp1) and not na(trade_best) and trade_best >= e_tp1
        tp1_reached := true
        active_sl   := math.max(nz(active_sl, e_sl), ep)   // At least entry price

if state == -1
    trade_best := na(trade_best) ? low : math.min(trade_best, low)
    // After TP1 genuinely reached, trail SL to breakeven
    if not na(e_tp1) and not na(trade_best) and trade_best <= e_tp1
        tp1_reached := true
        active_sl   := math.min(nz(active_sl, e_sl), ep)   // At least entry price

// ── EXIT: ST flip or session end ──────────────────────────────────────
exit_ce = state ==  1 and (st_dn or not in_session)
exit_pe = state == -1 and (st_up or not in_session)

if exit_ce or exit_pe
    state := 0

// ── Sync: if strategy SL was hit externally, reset state ──────────────
if strategy.position_size == 0 and state != 0
    state := 0

// ── ENTRY ─────────────────────────────────────────────────────────────
buy_ce = state == 0 and in_session and adx_ok and (st_up or bull_brk)
buy_pe = state == 0 and in_session and adx_ok and (st_dn or bear_brk)

if buy_ce
    state       := 1
    ep          := close
    e_sl        := ce_sl_at_entry
    e_risk      := ce_sl_d
    e_tp1       := close + ce_sl_d * i_rr1
    e_tp2       := close + ce_sl_d * i_rr2
    active_sl   := ce_sl_at_entry
    trade_best  := high
    tp1_reached := false

if buy_pe
    state       := -1
    ep          := close
    e_sl        := pe_sl_at_entry
    e_risk      := pe_sl_d
    e_tp1       := close - pe_sl_d * i_rr1
    e_tp2       := close - pe_sl_d * i_rr2
    active_sl   := pe_sl_at_entry
    trade_best  := low
    tp1_reached := false

// Entry mode (for tooltip)
var string ce_mode = "ST Flip"
var string pe_mode = "ST Flip"
if buy_ce
    ce_mode := (squeeze_off or in_squeeze) ? "Squeeze Break" : st_up ? "ST Flip" : "Range Break"
if buy_pe
    pe_mode := (squeeze_off or in_squeeze) ? "Squeeze Break" : st_dn ? "ST Flip" : "Range Break"

// Blocked
blk_ce = (st_up or bull_brk) and state == 0 and in_session and not adx_ok
blk_pe = (st_dn or bear_brk) and state == 0 and in_session and not adx_ok

// ════════════════════════════════════════════════════════════════════════
// STRATEGY EXECUTION
// Note: active_sl trails to breakeven after TP1 → big wins, small losses
// ════════════════════════════════════════════════════════════════════════

if buy_ce
    strategy.entry("CE", strategy.long)
if buy_pe
    strategy.entry("PE", strategy.short)
if strategy.position_size > 0
    strategy.exit("CE-SL", "CE", stop=active_sl)
if strategy.position_size < 0
    strategy.exit("PE-SL", "PE", stop=active_sl)
if exit_ce
    strategy.close("CE", comment="EXIT CE")
if exit_pe
    strategy.close("PE", comment="EXIT PE")

// ════════════════════════════════════════════════════════════════════════
// LABELS WITH HOVER TOOLTIPS
// ════════════════════════════════════════════════════════════════════════

// ── BUY CE ────────────────────────────────────────────────────────────
if buy_ce
    _sl_pts  = math.round(e_risk)
    _tp1_pts = math.round(e_risk * i_rr1)
    _tp2_pts = math.round(e_risk * i_rr2)
    _sq_s    = (in_squeeze or squeeze_off) ? "YES — compressed, big move loading" : "no"
    _cmf_s   = cmf_bull ? "+" + str.tostring(math.round(cmf * 100, 1)) + "%  buying" : str.tostring(math.round(cmf * 100, 1)) + "%  mixed"
    _htf_s   = htf_bull ? "1H BULL  +★ quality" : "1H BEAR  counter-trend"
    _tip = "BUY CE  " + ce_grade + "\n================================\nMode  : " + ce_mode + "\nEntry : " + str.tostring(math.round(ep, 0)) + "\nSL    : " + str.tostring(math.round(e_sl, 0)) + "  (-" + str.tostring(_sl_pts) + " pts)  [Chandelier]\nTP1   : " + str.tostring(math.round(e_tp1, 0)) + "  (+" + str.tostring(_tp1_pts) + " pts)  2.0R  Book 50%\nTP2   : " + str.tostring(math.round(e_tp2, 0)) + "  (+" + str.tostring(_tp2_pts) + " pts)  3.5R  Trail\n================================\nSL trails to breakeven after TP1\n================================\nADX   : " + str.tostring(math.round(adx, 1)) + "  " + (adx_rising ? "RISING ▲ accel" : "flat") + "\nCMF   : " + _cmf_s + "\nVol   : " + str.tostring(vol_pct) + "% avg\nSqueeze: " + _sq_s + "\n1H ST : " + _htf_s
    label.new(bar_index, low - atr * 0.5, text="BUY CE", tooltip=_tip, style=label.style_label_up, color=color.new(#00C853, 0), textcolor=color.black, size=size.large)

// ── BUY PE ────────────────────────────────────────────────────────────
if buy_pe
    _sl_pts  = math.round(e_risk)
    _tp1_pts = math.round(e_risk * i_rr1)
    _tp2_pts = math.round(e_risk * i_rr2)
    _sq_s    = (in_squeeze or squeeze_off) ? "YES — compressed, big move loading" : "no"
    _cmf_s   = cmf_bear ? str.tostring(math.round(cmf * 100, 1)) + "%  selling" : str.tostring(math.round(cmf * 100, 1)) + "%  mixed"
    _htf_s   = not htf_bull ? "1H BEAR  +★ quality" : "1H BULL  counter-trend"
    _tip = "BUY PE  " + pe_grade + "\n================================\nMode  : " + pe_mode + "\nEntry : " + str.tostring(math.round(ep, 0)) + "\nSL    : " + str.tostring(math.round(e_sl, 0)) + "  (+" + str.tostring(_sl_pts) + " pts)  [Chandelier]\nTP1   : " + str.tostring(math.round(e_tp1, 0)) + "  (-" + str.tostring(_tp1_pts) + " pts)  2.0R  Book 50%\nTP2   : " + str.tostring(math.round(e_tp2, 0)) + "  (-" + str.tostring(_tp2_pts) + " pts)  3.5R  Trail\n================================\nSL trails to breakeven after TP1\n================================\nADX   : " + str.tostring(math.round(adx, 1)) + "  " + (adx_rising ? "RISING ▲ accel" : "flat") + "\nCMF   : " + _cmf_s + "\nVol   : " + str.tostring(vol_pct) + "% avg\nSqueeze: " + _sq_s + "\n1H ST : " + _htf_s
    label.new(bar_index, high + atr * 0.5, text="BUY PE", tooltip=_tip, style=label.style_label_down, color=color.new(#D50000, 0), textcolor=color.white, size=size.large)

// ── EXIT CE ───────────────────────────────────────────────────────────
if exit_ce
    _pnl   = math.round(close - ep)
    _res   = _pnl >= 0 ? "PROFIT  +" + str.tostring(_pnl) + " pts" : "LOSS    " + str.tostring(_pnl) + " pts"
    // FIX: use trade_best (actual highest price seen), not a % approximation
    _h2    = not na(trade_best) and not na(e_tp2) and trade_best >= e_tp2
    _h1    = not na(trade_best) and not na(e_tp1) and trade_best >= e_tp1
    _status = _h2 ? "TP2 reached ✓" : _h1 ? "TP1 reached ✓  (SL trailed to BE)" : _pnl >= 0 ? "Profitable — TP1 not quite reached" : "Loss — TP1 never reached"
    _sl_note = tp1_reached ? "SL was at breakeven (protected)" : "SL was at original Chandelier level"
    _tip = "EXIT CE\n================================\nExit  : " + str.tostring(math.round(close, 0)) + "\nEntry : " + str.tostring(math.round(ep, 0)) + "\nP&L   : " + _res + "\nStatus: " + _status + "\n" + _sl_note + "\n================================\nReason: 15m ST flipped bearish\nAction: Close your CE now"
    label.new(bar_index, high + atr * 0.5, text="EXIT CE", tooltip=_tip, style=label.style_label_down, color=color.new(#FF6F00, 0), textcolor=color.black, size=size.large)

// ── EXIT PE ───────────────────────────────────────────────────────────
if exit_pe
    _pnl   = math.round(ep - close)
    _res   = _pnl >= 0 ? "PROFIT  +" + str.tostring(_pnl) + " pts" : "LOSS    " + str.tostring(_pnl) + " pts"
    // FIX: use trade_best (actual lowest price seen), not a % approximation
    _h2    = not na(trade_best) and not na(e_tp2) and trade_best <= e_tp2
    _h1    = not na(trade_best) and not na(e_tp1) and trade_best <= e_tp1
    _status = _h2 ? "TP2 reached ✓" : _h1 ? "TP1 reached ✓  (SL trailed to BE)" : _pnl >= 0 ? "Profitable — TP1 not quite reached" : "Loss — TP1 never reached"
    _sl_note = tp1_reached ? "SL was at breakeven (protected)" : "SL was at original Chandelier level"
    _tip = "EXIT PE\n================================\nExit  : " + str.tostring(math.round(close, 0)) + "\nEntry : " + str.tostring(math.round(ep, 0)) + "\nP&L   : " + _res + "\nStatus: " + _status + "\n" + _sl_note + "\n================================\nReason: 15m ST flipped bullish\nAction: Close your PE now"
    label.new(bar_index, low - atr * 0.5, text="EXIT PE", tooltip=_tip, style=label.style_label_up, color=color.new(#FF6F00, 0), textcolor=color.black, size=size.large)

// ════════════════════════════════════════════════════════════════════════
// SL / TP LINES
// ════════════════════════════════════════════════════════════════════════

if (buy_ce or buy_pe) and i_show_tp
    _sl_d  = math.round(e_risk)
    _tp1_d = math.round(e_risk * i_rr1)
    _tp2_d = math.round(e_risk * i_rr2)
    line.new(bar_index, e_sl,  bar_index + 50, e_sl,  color=color.new(color.red,  10), width=1, style=line.style_dashed)
    line.new(bar_index, e_tp1, bar_index + 50, e_tp1, color=color.new(color.lime, 10), width=1, style=line.style_dashed)
    line.new(bar_index, e_tp2, bar_index + 50, e_tp2, color=color.new(color.lime, 10), width=2, style=line.style_dashed)
    label.new(bar_index + 2, e_sl,  text="SL  "  + str.tostring(math.round(e_sl,  0)), tooltip="Chandelier SL: "  + str.tostring(math.round(e_sl, 0))  + "\n-" + str.tostring(_sl_d)  + " pts\nAfter TP1: trails to breakeven",  style=label.style_label_right, color=color.new(color.red,  20), textcolor=color.white, size=size.small)
    label.new(bar_index + 2, e_tp1, text="TP1 "  + str.tostring(math.round(e_tp1, 0)), tooltip="Target 1: +"      + str.tostring(_tp1_d) + " pts  2.0R\nBook 50% here — SL moves to breakeven", style=label.style_label_right, color=color.new(color.lime, 20), textcolor=color.black, size=size.small)
    label.new(bar_index + 2, e_tp2, text="TP2 "  + str.tostring(math.round(e_tp2, 0)), tooltip="Target 2: +"      + str.tostring(_tp2_d) + " pts  3.5R\nTrail remaining 50% — exit on ST flip", style=label.style_label_right, color=color.new(color.lime, 20), textcolor=color.black, size=size.small)

// ════════════════════════════════════════════════════════════════════════
// BLOCKED DOTS + SQUEEZE MARKER
// ════════════════════════════════════════════════════════════════════════

plotshape(i_show_bk and blk_ce, "Blocked CE", shape.circle, location.belowbar, color.new(#00C853, 70), size=size.tiny)
plotshape(i_show_bk and blk_pe, "Blocked PE", shape.circle, location.abovebar, color.new(#D50000, 70), size=size.tiny)

// Squeeze warning: orange dot when in squeeze (spring loading)
plotshape(
     series=in_squeeze,
     title="Squeeze Active",
     style=shape.diamond,
     location=location.bottom,
     color=color.new(color.orange, 40),
     size=size.tiny
 )

plotshape(
     series=squeeze_off,
     title="Squeeze Released!",
     style=shape.diamond,
     location=location.bottom,
     color=color.new(color.white, 0),
     size=size.small
 )

// ════════════════════════════════════════════════════════════════════════
// CHART PLOTS
// ════════════════════════════════════════════════════════════════════════

// Supertrend
plot(i_show_st ? st_val : na, "Supertrend", st_bull ? color.new(#00C853, 0) : color.new(#D50000, 0), 2)

// LSMA — fast trend line
plot(lsma, "LSMA (20)", color.new(color.aqua, 40), 1)

// VWAP
plot(i_show_vw ? vwap : na, "VWAP", color.new(#2962FF, 15), 2)

// Bollinger Bands (optional)
plot(i_show_bb ? bb_upper : na, "BB Upper", color.new(color.gray, 60), 1)
plot(i_show_bb ? bb_lower : na, "BB Lower", color.new(color.gray, 60), 1)
plot(i_show_bb ? bb_basis : na, "BB Mid",   color.new(color.gray, 75), 1)

// Zone backgrounds
bgcolor(state ==  1 ? color.new(color.green,  93) : na, title="CE Zone")
bgcolor(state == -1 ? color.new(color.red,    93) : na, title="PE Zone")
bgcolor(is_expiry and in_session ? color.new(color.orange, 95) : na, title="Expiry")
bgcolor(in_squeeze ? color.new(color.blue, 97) : na, title="Squeeze Zone")

// Live SL/TP lines (active_sl trails to breakeven after TP1)
plot(state ==  1 ? active_sl : na, "CE SL  active", color.new(color.red,    0), 1, plot.style_linebr)
plot(state ==  1 ? e_tp1    : na, "CE TP1 live",   color.new(color.lime,   0), 1, plot.style_linebr)
plot(state ==  1 ? e_tp2    : na, "CE TP2 live",   color.new(color.lime,   0), 2, plot.style_linebr)
plot(state == -1 ? active_sl : na, "PE SL  active", color.new(color.red,    0), 1, plot.style_linebr)
plot(state == -1 ? e_tp1    : na, "PE TP1 live",   color.new(color.lime,   0), 1, plot.style_linebr)
plot(state == -1 ? e_tp2    : na, "PE TP2 live",   color.new(color.lime,   0), 2, plot.style_linebr)
plot(state !=  0 ? ep       : na, "Entry  live",   color.new(color.yellow, 20), 1, plot.style_linebr)

// ════════════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ════════════════════════════════════════════════════════════════════════

var table d = table.new(position.top_right, 2, 18, bgcolor=color.new(color.black, 72), border_width=1, border_color=color.new(color.gray, 55), frame_color=color.new(color.gray, 55), frame_width=1)

G  = color.new(color.lime,   0)
R  = color.new(color.red,    0)
W  = color.new(color.white,  0)
Gr = color.new(color.gray,  25)
Y  = color.new(color.yellow, 0)
O  = color.new(color.orange, 0)
Aq = color.new(color.aqua,   0)

if barstate.islast
    table.cell(d, 0, 0,  "NIFTY 15M v10",    text_color=Gr, text_size=size.small)
    table.cell(d, 1, 0,  is_expiry ? "EXPIRY" : "Normal", text_color=is_expiry ? Y : Gr, text_size=size.small)
    table.cell(d, 0, 1,  "Session",           text_color=W,  text_size=size.small)
    table.cell(d, 1, 1,  in_session ? "OPEN  9:30-14:30" : "CLOSED", text_color=in_session ? G : R, text_size=size.small)
    table.cell(d, 0, 2,  "15m ST",            text_color=W,  text_size=size.small)
    table.cell(d, 1, 2,  st_bull ? "BULL ▲" : "BEAR ▼", text_color=st_bull ? G : R, text_size=size.small)
    table.cell(d, 0, 3,  "LSMA (trend)",      text_color=W,  text_size=size.small)
    table.cell(d, 1, 3,  lsma_bull ? "BULL price>LSMA" : "BEAR price<LSMA", text_color=lsma_bull ? G : R, text_size=size.small)
    adx_col = adx_strong ? G : adx_ok ? Y : R
    adx_dir = adx_rising ? " ▲ accel" : " — flat"
    table.cell(d, 0, 4,  "ADX",               text_color=W,  text_size=size.small)
    table.cell(d, 1, 4,  str.tostring(math.round(adx, 1)) + (adx_strong ? " STRONG" : adx_ok ? " TREND" : " CHOP") + adx_dir, text_color=adx_col, text_size=size.small)
    sqz_col = squeeze_off ? Y : in_squeeze ? O : Gr
    sqz_lbl = squeeze_off ? "JUST FIRED ★" : in_squeeze ? "LOADING  ◆" : "no squeeze"
    table.cell(d, 0, 5,  "BB Squeeze",        text_color=W,  text_size=size.small)
    table.cell(d, 1, 5,  sqz_lbl, text_color=sqz_col, text_size=size.small)
    cmf_col = cmf_bull ? G : cmf_bear ? R : Gr
    table.cell(d, 0, 6,  "CMF (money flow)",  text_color=W,  text_size=size.small)
    table.cell(d, 1, 6,  str.tostring(math.round(cmf * 100, 1)) + "%  " + (cmf_bull ? "BUYING ▲" : cmf_bear ? "SELLING ▼" : "neutral"), text_color=cmf_col, text_size=size.small)
    table.cell(d, 0, 7,  "Volume",            text_color=W,  text_size=size.small)
    table.cell(d, 1, 7,  str.tostring(vol_pct) + "%  " + (vol_ok ? "SPIKE ✓" : "normal"), text_color=vol_ok ? G : Gr, text_size=size.small)
    vd = math.round((close - vwap) / vwap * 100, 2)
    table.cell(d, 0, 8,  "VWAP",              text_color=W,  text_size=size.small)
    table.cell(d, 1, 8,  (close > vwap ? "ABOVE +" : "BELOW ") + str.tostring(vd) + "%", text_color=close > vwap ? G : R, text_size=size.small)
    table.cell(d, 0, 9,  "1H ST (quality)",   text_color=W,  text_size=size.small)
    table.cell(d, 1, 9,  htf_bull ? "BULL ▲  +star" : "BEAR ▼", text_color=htf_bull ? G : R, text_size=size.small)
    table.cell(d, 0, 10, "ATR",               text_color=W,  text_size=size.small)
    table.cell(d, 1, 10, str.tostring(math.round(atr, 0)) + " pts", text_color=W, text_size=size.small)
    table.cell(d, 0, 11, "Entry / SL",        text_color=W,  text_size=size.small)
    if state != 0
        _sl_show = tp1_reached ? str.tostring(math.round(ep, 0)) + " (BE)" : str.tostring(math.round(e_sl, 0))
        table.cell(d, 1, 11, str.tostring(math.round(ep, 0)) + " / " + _sl_show, text_color=state == 1 ? G : R, text_size=size.small)
    else
        table.cell(d, 1, 11, "—", text_color=Gr, text_size=size.small)
    table.cell(d, 0, 12, "TP1  /  TP2",       text_color=W,  text_size=size.small)
    if state != 0
        table.cell(d, 1, 12, str.tostring(math.round(e_tp1, 0)) + " / " + str.tostring(math.round(e_tp2, 0)), text_color=G, text_size=size.small)
    else
        table.cell(d, 1, 12, "—", text_color=Gr, text_size=size.small)
    pnl   = state ==  1 ? math.round(close - ep) : state == -1 ? math.round(ep - close) : 0
    pnl_c = pnl > 0 ? G : pnl < 0 ? R : Gr
    table.cell(d, 0, 13, "Live P&L",          text_color=W,  text_size=size.small)
    table.cell(d, 1, 13, state != 0 ? (pnl >= 0 ? "+" : "") + str.tostring(pnl) + " pts" + (tp1_reached ? "  [BE protected]" : "") : "—", text_color=pnl_c, text_size=size.small)
    q   = state ==  1 ? ce_q : state == -1 ? pe_q : 0
    q_c = q == 3 ? G : q == 2 ? Y : q >= 1 ? O : Gr
    table.cell(d, 0, 14, "Quality",           text_color=W,  text_size=size.small)
    table.cell(d, 1, 14, state == 1 ? str.tostring(ce_q) + "/3  " + ce_grade : state == -1 ? str.tostring(pe_q) + "/3  " + pe_grade : "—", text_color=q_c, text_size=size.small)
    why = state == 1 ? "IN CE — holding" : state == -1 ? "IN PE — holding" : not in_session ? "Outside 9:30-14:30" : not adx_ok ? "ADX " + str.tostring(math.round(adx, 0)) + " < " + str.tostring(i_adx_t) + "  chop" : in_squeeze ? "Squeeze loading  — wait for release" : "Waiting for ST flip / squeeze break"
    table.cell(d, 0, 15, "Status",            text_color=Gr, text_size=size.small)
    table.cell(d, 1, 15, why, text_color=Gr, text_size=size.small)
    st_bg2  = state ==  1 ? color.new(#00C853, 68) : state == -1 ? color.new(#D50000, 68) : color.new(color.black, 80)
    st_col2 = state ==  1 ? G : state == -1 ? R : Gr
    table.cell(d, 0, 16, "Trade State",       text_color=W, text_size=size.small, bgcolor=st_bg2)
    table.cell(d, 1, 16, state == 1 ? "IN CE" : state == -1 ? "IN PE" : "FLAT", text_color=st_col2, text_size=size.small, bgcolor=st_bg2)
    sig_bg = buy_ce ? color.new(#00C853, 65) : buy_pe ? color.new(#D50000, 65) : exit_ce ? color.new(#FF6F00, 65) : exit_pe ? color.new(#FF6F00, 65) : color.new(color.black, 80)
    sig_c  = buy_ce ? G : buy_pe ? R : exit_ce ? O : exit_pe ? O : Gr
    sig_t  = buy_ce ? "BUY CE" : buy_pe ? "BUY PE" : exit_ce ? "EXIT CE — now" : exit_pe ? "EXIT PE — now" : "— WAIT —"
    table.cell(d, 0, 17, "SIGNAL",            text_color=W,     text_size=size.small, bgcolor=sig_bg)
    table.cell(d, 1, 17, sig_t,               text_color=sig_c, text_size=size.small, bgcolor=sig_bg)

// ════════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════════

alertcondition(buy_ce,    "BUY CE",      "BUY CE  | NIFTY {{close}}")
alertcondition(buy_pe,    "BUY PE",      "BUY PE  | NIFTY {{close}}")
alertcondition(exit_ce,   "EXIT CE",     "EXIT CE | NIFTY {{close}} — Close CE now")
alertcondition(exit_pe,   "EXIT PE",     "EXIT PE | NIFTY {{close}} — Close PE now")
alertcondition(squeeze_off, "Squeeze!",  "SQUEEZE FIRE | NIFTY {{close}} — Big move starting")
alertcondition(strategy.position_size > 0 and ta.crossunder(close, active_sl), "CE SL Hit", "CE SL HIT | NIFTY {{close}}")
alertcondition(strategy.position_size < 0 and ta.crossover (close, active_sl), "PE SL Hit", "PE SL HIT | NIFTY {{close}}")
